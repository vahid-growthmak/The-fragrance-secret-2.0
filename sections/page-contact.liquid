
    <!-- HERO -->
    <section class="page-hero tall">
      <div class="container">
        <div class="breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span class="mi" aria-hidden="true">chevron_right</span>
          <span>Contact</span>
        </div>
        <span class="ph-eyebrow">We're Here to Help</span>
        <h1 class="ph-title">Let's <em>Talk</em> Fragrance</h1>
        <p class="ph-sub">Question about a scent, an order, or which oud suits a Dubai summer? Our Dubai-based team replies personally — most messages get an answer the same day, 10am to 7pm.</p>
        <div class="ph-meta">
          <span><span class="mi" aria-hidden="true">chat</span>WhatsApp 10am–7pm</span>
          <span><span class="mi" aria-hidden="true">bolt</span>Same-day replies</span>
          <span><span class="mi" aria-hidden="true">location_on</span>Dubai, UAE</span>
        </div>
      </div>
    </section>

    <!-- CONTACT METHODS + FORM -->
    <section class="section">
      <div class="container">
        <div class="sec-head center fade-up">
          <span class="label">Reach Out</span>
          <h2 class="sec-title">Ways to <em>Connect</em></h2>
          <p class="sec-sub">Pick whatever's easiest — we're quick on all of them.</p>
        </div>
        <div class="contact-grid">
          <div class="contact-methods fade-up">
            <div class="cm-card">
              <div class="cm-ic"><span class="mi" aria-hidden="true">mail</span></div>
              <div>
                <h3>Email Us</h3>
                <p>For orders, partnerships and general questions.</p>
                <p><a href="mailto:info@thefragrancesecrets.com">info@thefragrancesecrets.com</a></p>
              </div>
            </div>
            <div class="cm-card">
              <div class="cm-ic"><span class="mi" aria-hidden="true">chat</span></div>
              <div>
                <h3>WhatsApp</h3>
                <p>Fastest way to reach a real human on our team.</p>
                <p><a href="#" onclick="waChat();return false">Chat with us — daily 10am to 7pm</a></p>
              </div>
            </div>
            <div class="cm-card">
              <div class="cm-ic"><span class="mi" aria-hidden="true">call</span></div>
              <div>
                <h3>Call Us</h3>
                <p>Prefer to talk it through? Give us a ring.</p>
                <p><a href="tel:+97141234567">+971 4 123 4567</a></p>
              </div>
            </div>
            <div class="cm-card">
              <div class="cm-ic"><span class="mi" aria-hidden="true">schedule</span></div>
              <div>
                <h3>Support Hours</h3>
                <p>Saturday to Thursday, 10:00am – 7:00pm (GST). Friday replies may be slightly slower.</p>
              </div>
            </div>
          </div>

          {%- comment -%}
            Shopify's native contact form. It previously had no action, no field
            names and a Send Message button wired to waChat(), so it collected
            nothing and opened WhatsApp — which the card above already offers.

            Fields carry real names so Shopify delivers them, required on the
            three that matter, and the values are echoed back on error so a
            failed submit does not wipe what was typed.
          {%- endcomment -%}
          {%- form 'contact', class: 'contact-form fade-up' -%}
            {%- if form.posted_successfully? -%}
              <p class="form-note form-note--ok" role="status">
                <span class="mi" aria-hidden="true">check_circle</span>
                Thank you — your message is with our team. We reply within a few hours during support hours.
              </p>
            {%- elsif form.errors -%}
              <p class="form-note form-note--err" role="alert">
                <span class="mi" aria-hidden="true">error</span>
                {{ form.errors | default_errors }}
              </p>
            {%- endif -%}

            <div class="form-row">
              <div class="field">
                <label for="ContactName">Name</label>
                <input id="ContactName" type="text" name="contact[name]" autocomplete="name" required
                       placeholder="Your full name" value="{{ form.name }}">
              </div>
              <div class="field">
                <label for="ContactEmail">Email</label>
                <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required
                       placeholder="you@email.com" value="{{ form.email }}">
              </div>
            </div>
            <div class="form-row">
              <div class="field">
                <label for="ContactPhone">Phone (optional)</label>
                <input id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel"
                       placeholder="+971 5X XXX XXXX" value="{{ form.phone }}">
              </div>
              <div class="field">
                <label for="ContactTopic">Topic</label>
                <select id="ContactTopic" name="contact[topic]">
                  <option>General enquiry</option>
                  <option>Order &amp; delivery</option>
                  <option>Product &amp; authenticity</option>
                  <option>Returns &amp; refunds</option>
                  <option>Partnership</option>
                </select>
              </div>
            </div>
            <div class="field full">
              <label for="ContactBody">Message</label>
              <textarea id="ContactBody" name="contact[body]" rows="5" required
                        placeholder="How can we help?">{{ form.body }}</textarea>
            </div>
            <button class="btn-g" type="submit">Send Message</button>
            <p class="sec-sub">We typically reply within a few hours during support hours. Prefer to chat? <a href="#" onclick="waChat();return false">Message us on WhatsApp</a>.</p>
          {%- endform -%}
        </div>
      </div>
    </section>

    <!-- LOCATIONS -->
    <section class="section alt">
      <div class="container">
        <div class="sec-head center fade-up">
          <span class="label">Find Us</span>
          <h2 class="sec-title">Our <em>Location</em></h2>
          <p class="sec-sub">Proudly based in Dubai, delivering to all seven Emirates.</p>
        </div>
        <div class="contact-grid">
          <div class="fade-up">
            <div class="map-embed">
              <div class="map-canvas" role="img" aria-label="Map of our Dubai location"></div>
              <span class="map-pin"><span class="mi mi-f" aria-hidden="true">location_on</span></span>
            </div>
          </div>
          <div class="contact-methods fade-up">
            <div class="cm-card">
              <div class="cm-ic"><span class="mi" aria-hidden="true">store</span></div>
              <div>
                <h3>Head Office</h3>
                <p>The Fragrance Secrets<br />Business Bay, Dubai, United Arab Emirates</p>
              </div>
            </div>
            <div class="cm-card">
              <div class="cm-ic"><span class="mi" aria-hidden="true">local_shipping</span></div>
              <div>
                <h3>Delivery Coverage</h3>
                <p>Free delivery on orders above AED 150. Cash on delivery available across all seven Emirates. Same-day dispatch on in-stock orders.</p>
              </div>
            </div>
            <div class="cm-card">
              <div class="cm-ic"><span class="mi" aria-hidden="true">schedule</span></div>
              <div>
                <h3>Opening Hours</h3>
                <p>Saturday – Thursday: 10:00am – 7:00pm<br />Friday: Limited support</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHATSAPP QUICK-LINK BAND -->
    <section class="section">
      <div class="container">
        <div class="cta-band fade-up">
          <span class="label" style="color:var(--gold)">Instant Support</span>
          <h2 class="sec-title">Need an Answer <em>Now?</em></h2>
          <p class="sec-sub">Skip the form — message our team on WhatsApp and chat with a real person about anything, from sizing to same-day delivery.</p>
          <div class="cta-actions">
            <a class="btn-g" href="#" onclick="waChat();return false">Chat on WhatsApp</a>
            <a class="btn-o" href="/pages/faqs">Read FAQs</a>
          </div>
        </div>
      </div>
    </section>

{% schema %}
{ "name": "Contact page", "settings": [] }
{% endschema %}
