{%- comment -%}
  Collection page — native Shopify port of collection.html + collections.js.
  Uses collection.filters (configured in Search & Discovery) and
  collection.products with pagination + sort. Reproduces the .shop-layout /
  .shop-filters / .shop-results markup so the existing CSS applies unchanged.
{%- endcomment -%}

{%- liquid
  assign hero_image = collection.image | default: collection.metafields.custom.hero_image.value
  assign paginate_by = section.settings.products_per_page | default: 24

  assign hero_eyebrow = section.settings.hero_eyebrow | default: 'The Collection'
  assign hero_heading = section.settings.hero_heading | default: collection.title
  assign hero_image_alt = section.settings.hero_image_alt | default: collection.title
  assign crumb_parent_label = section.settings.crumb_parent_label | default: 'Shop'
  assign crumb_parent_url = section.settings.crumb_parent_url | default: '/collections/all'
-%}

<div data-collection-native>

  <!-- PAGE HERO -->
  {%- capture collection_breadcrumb -%}
    <div class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="mi" aria-hidden="true">chevron_right</span>
      <a href="{{ crumb_parent_url }}">{{ crumb_parent_label }}</a>
      <span class="mi" aria-hidden="true">chevron_right</span>
      <span>{{ hero_heading | strip_html }}</span>
    </div>
  {%- endcapture -%}

  {%- capture hero_facts -%}
    <div class="ph-meta">
      <span><span class="mi" aria-hidden="true">verified_user</span>100% Authentic</span>
      <span><span class="mi" aria-hidden="true">local_shipping</span>Fast Shipping</span>
      <span><span class="mi" aria-hidden="true">lock</span>Secure Checkout</span>
    </div>
  {%- endcapture -%}

  {%- if hero_image -%}
    <section class="page-hero split tall">
      <div class="container">
        <div>
          {{ collection_breadcrumb }}
          <span class="ph-eyebrow">{{ hero_eyebrow }}</span>
          <h1 class="ph-title">{{ hero_heading }}</h1>
          {%- if collection.description != blank and section.settings.show_hero_description -%}<p class="ph-sub">{{ collection.description }}</p>{%- endif -%}
          {{ hero_facts }}
        </div>
        <figure class="ph-figure"><img src="{{ hero_image | image_url: width: 1200 }}" alt="{{ hero_image_alt | escape }}"></figure>
      </div>
    </section>
  {%- else -%}
    <section class="page-hero tall">
      <div class="container">
        {{ collection_breadcrumb }}
        <span class="ph-eyebrow">{{ hero_eyebrow }}</span>
        <h1 class="ph-title">{{ hero_heading }}</h1>
        {%- if collection.description != blank and section.settings.show_hero_description -%}<p class="ph-sub">{{ collection.description }}</p>{%- endif -%}
        {{ hero_facts }}
      </div>
    </section>
  {%- endif -%}

  <!-- TRUST BAND -->
  {%- if section.settings.show_trust_band -%}
    <section class="section-sm alt"><div class="container">
      <div class="trust-band">
        <div class="tb-item"><span class="mi" aria-hidden="true">verified_user</span><div><strong>100% Authentic</strong><span>Verified sourcing</span></div></div>
        <div class="tb-item"><span class="mi" aria-hidden="true">local_shipping</span><div><strong>Free UAE Delivery</strong><span>On orders above AED 150</span></div></div>
        <div class="tb-item"><span class="mi" aria-hidden="true">payments</span><div><strong>Cash on Delivery</strong><span>Available UAE-wide</span></div></div>
        <div class="tb-item"><span class="mi" aria-hidden="true">autorenew</span><div><strong>7-Day Returns</strong><span>No questions asked</span></div></div>
      </div>
    </div></section>
  {%- endif -%}

  <!-- COLLECTION INTRODUCTION -->
  {%- if section.settings.intro_heading != blank or section.settings.intro_text != blank -%}
    <section class="section-sm coll-intro"><div class="container coll-intro-grid">
      <div class="coll-intro-copy">
        {%- if section.settings.intro_eyebrow != blank -%}<span class="label">{{ section.settings.intro_eyebrow }}</span>{%- endif -%}
        {%- if section.settings.intro_heading != blank -%}<h2 class="sec-title">{{ section.settings.intro_heading }}</h2>{%- endif -%}
        {%- if section.settings.intro_text != blank -%}<div class="sec-sub coll-intro-body">{{ section.settings.intro_text }}</div>{%- endif -%}
      </div>

      {%- if section.settings.show_why_rotator -%}
        <aside class="wc-rotator" id="wcRotator-{{ section.id }}" aria-label="Why choose The Fragrance Secrets">
          <div class="wc-head">
            <span class="label">Why Choose Us</span>
            <span class="wc-count"><b data-wc-now>1</b>/6</span>
          </div>
          <div class="wc-stage">
            <div class="wc-slide is-active"><span class="mi" aria-hidden="true">verified</span><b>100% Authentic Perfumes</b><p>Every fragrance is genuine and sourced through trusted suppliers, checked before it ships.</p></div>
            <div class="wc-slide"><span class="mi" aria-hidden="true">local_shipping</span><b>Fast UAE Delivery</b><p>Quick delivery across Dubai, Abu Dhabi, Sharjah and the wider Emirates.</p></div>
            <div class="wc-slide"><span class="mi" aria-hidden="true">lock</span><b>Secure Payments</b><p>Pay safely by card, wallet or cash on delivery, whichever suits you best.</p></div>
            <div class="wc-slide"><span class="mi" aria-hidden="true">diamond</span><b>Premium Fragrance Collection</b><p>Designer houses and Arabian perfumery, side by side in one place.</p></div>
            <div class="wc-slide"><span class="mi" aria-hidden="true">inventory_2</span><b>Carefully Packed Orders</b><p>Every order is packed with care so it arrives sealed, safe and gift-ready.</p></div>
            <div class="wc-slide"><span class="mi" aria-hidden="true">redeem</span><b>Perfect for Gifting</b><p>Ready-wrapped sets and premium packaging for weddings, Eid and birthdays.</p></div>
          </div>
          <div class="wc-dots">
            <button type="button" class="is-active" aria-label="Slide 1"></button>
            <button type="button" aria-label="Slide 2"></button>
            <button type="button" aria-label="Slide 3"></button>
            <button type="button" aria-label="Slide 4"></button>
            <button type="button" aria-label="Slide 5"></button>
            <button type="button" aria-label="Slide 6"></button>
          </div>
        </aside>
      {%- endif -%}
    </div></section>

    {%- if section.settings.show_why_rotator -%}
      <script>
          (function () {
            var root = document.getElementById('wcRotator-{{ section.id }}');
            if (!root) return;
            var slides = root.querySelectorAll('.wc-slide');
            var dots = root.querySelectorAll('.wc-dots button');
            var now = root.querySelector('[data-wc-now]');
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var i = 0, timer = null;
            function show(n) {
              slides[i].classList.remove('is-active');
              dots[i].classList.remove('is-active');
              i = (n + slides.length) % slides.length;
              slides[i].classList.add('is-active');
              dots[i].classList.add('is-active');
              if (now) now.textContent = i + 1;
            }
            function stop() { if (timer) { clearInterval(timer); timer = null; } }
            function start() { if (reduce) return; stop(); timer = setInterval(function () { show(i + 1); }, 4000); }
            dots.forEach(function (d, idx) { d.addEventListener('click', function () { show(idx); start(); }); });
            root.addEventListener('mouseenter', stop);
            root.addEventListener('mouseleave', start);
            start();
          })();
      </script>
    {%- endif -%}
  {%- endif -%}

  <!-- FILTER BAR (mobile toggle) -->
  <div class="filter-bar" id="filterBar"><div class="container"><div class="fb-inner">
    <button type="button" class="fb-toggle" id="fbToggle" onclick="document.getElementById('shopFilters').classList.add('open');document.getElementById('sfOverlay').classList.add('open')"><span class="mi" aria-hidden="true">tune</span>Filters &amp; Sort</button>
  </div></div></div>

  {%- paginate collection.products by paginate_by -%}
  <section class="section" id="grid"><div class="container">
    <div class="results-head">
      <div><span class="label">The Collection</span><h2 class="sec-title results-title">Shop the Range</h2></div>
      <div class="results-count">{{ collection.products_count }} products</div>
    </div>

    <div class="shop-layout">
      <aside class="shop-filters" id="shopFilters" aria-label="Product filters">
        <form>
          <div class="sf-head">
            <span class="sf-title"><span class="mi" aria-hidden="true">tune</span>Filters</span>
            <a class="sf-clear" href="{{ collection.url }}">Clear all</a>
            <button type="button" class="sf-close" id="sfClose" aria-label="Close filters" onclick="document.getElementById('shopFilters').classList.remove('open');document.getElementById('sfOverlay').classList.remove('open')"><span class="mi" aria-hidden="true">close</span></button>
          </div>
          <div class="sf-scroll">
            <div class="sf-group sf-sortgroup">
              <div class="sf-gtitle sf-gtitle-static">Sort By</div>
              <div class="sf-gbody">
                <select class="sf-sort" name="sort_by" onchange="this.form.submit()">
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value }}"{% if option.value == collection.sort_by or option.value == collection.default_sort_by %} selected{% endif %}>{{ option.name }}</option>
                  {%- endfor -%}
                </select>
              </div>
            </div>

            {%- for filter in collection.filters -%}
              <details class="sf-group" open {{ filter.shopify_attributes }}>
                <summary class="sf-gtitle">{{ filter.label }}<span class="mi sf-chev" aria-hidden="true">expand_more</span></summary>
                <div class="sf-gbody">
                  {%- case filter.type -%}
                    {%- when 'list' -%}
                      <div class="sf-opts">
                        {%- for value in filter.values -%}
                          <label class="sf-opt">
                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %} onchange="this.form.submit()">
                            <span class="sf-box"><span class="mi" aria-hidden="true">check</span></span>
                            <span class="sf-label">{{ value.label }}</span>
                            <span class="sf-count">{{ value.count }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- when 'price_range' -%}
                      <div class="sf-price">
                        <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="Min {{ filter.range_max | money_without_currency }}" min="0" onchange="this.form.submit()">
                        <span>to</span>
                        <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="Max {{ filter.range_max | money_without_currency }}" min="0" onchange="this.form.submit()">
                      </div>
                  {%- endcase -%}
                </div>
              </details>
            {%- endfor -%}
          </div>
        </form>
      </aside>

      <div class="shop-results">
        {%- if collection.products.size > 0 -%}
          <div class="products-grid" id="collGrid">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <div class="pagination">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page"><span class="mi" aria-hidden="true">chevron_left</span></a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}<span class="current">{{ part.title }}</span>
                {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page"><span class="mi" aria-hidden="true">chevron_right</span></a>{%- endif -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="empty-state" style="text-align:center;padding:60px 20px">
            <span class="mi" aria-hidden="true" style="font-size:48px;color:var(--gold)">search_off</span>
            <h3 class="sec-title">No products yet</h3>
            <p class="sec-sub">This collection is being curated. Explore all products in the meantime.</p>
            <a class="btn-g" href="/collections/all">Shop All Products</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div></section>
  <div class="sf-overlay" id="sfOverlay" onclick="document.getElementById('shopFilters').classList.remove('open');this.classList.remove('open')"></div>
  {%- endpaginate -%}

  <!-- FIND MY SCENT -->
  {%- if section.settings.show_finder -%}
    <section class="finder"><div class="finder-inner">
      <div class="finder-head fade-up">
        <span class="label">Personalised Recommendation</span>
        <h2 class="sec-title" style="color:var(--white)">Not Sure What to <em>Pick?</em></h2>
        <p class="sec-sub">Answer 3 quick questions and we'll find your perfect fragrance match.</p>
      </div>
      <div class="quiz-progress quiz-progress-wrap"></div>
      <div class="quiz-container-wrap"></div>
    </div></section>
  {%- endif -%}

  <!-- REVIEWS -->
  {%- if section.settings.show_reviews -%}
    <section class="reviews"><div class="reviews-inner">
      <div class="reviews-head fade-up"><span class="label">What Customers Say</span><h2 class="sec-title">Loved by <em>Fragrance Lovers</em></h2></div>
      <div class="rv-grid" data-render="reviews" data-count="3"></div>
    </div></section>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "hero_heading", "label": "Heading (H1)", "info": "Leave blank to use the collection title." },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt text", "info": "Leave blank to use the collection title." },
    { "type": "checkbox", "id": "show_hero_description", "label": "Show collection description in hero", "default": true },
    { "type": "text", "id": "crumb_parent_label", "label": "Breadcrumb parent label", "default": "Shop" },
    { "type": "text", "id": "crumb_parent_url", "label": "Breadcrumb parent URL", "default": "/collections/all" },
    { "type": "header", "content": "Sections" },
    { "type": "checkbox", "id": "show_trust_band", "label": "Show trust band under the hero", "default": true },
    { "type": "checkbox", "id": "show_finder", "label": "Show 'Find my scent' quiz after the grid", "default": true },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews after the grid", "default": true, "info": "Turn off when a page section renders reviews further down." },
    { "type": "header", "content": "Collection introduction" },
    { "type": "text", "id": "intro_eyebrow", "label": "Intro eyebrow" },
    { "type": "text", "id": "intro_heading", "label": "Intro heading (H2)", "info": "Carries the page's primary keyword. Leave blank to hide the intro." },
    { "type": "richtext", "id": "intro_text", "label": "Intro copy" },
    { "type": "checkbox", "id": "show_why_rotator", "label": "Show 'Why choose us' rotator beside the intro", "default": false }
  ],
  "presets": [ { "name": "Collection page" } ]
}
{% endschema %}
