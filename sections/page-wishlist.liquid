{%- comment -%}
  Wishlist page.

  Previously this rendered four hardcoded demo products with invented prices,
  and its buttons only removed DOM nodes. It now reads the saved handles from
  TFSWishlist (localStorage) and rehydrates each one from /products/<handle>.js,
  so titles, images, prices and variant ids are always live rather than a stale
  copy captured at save time.

  Products that 404 — unpublished, deleted, or handle changed — are dropped from
  the saved list as they are discovered, so the wishlist cannot rot into links
  that go nowhere.
{%- endcomment -%}

    <style>
    /* ── Wishlist ── */
    .wish-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
    .wish-toolbar .wish-count { font-size: .86rem; color: var(--warm); }
    .wish-toolbar .wish-count b { color: var(--ink); }
    .wish-card .prod-info { display: flex; flex-direction: column; }
    .wish-actions { display: flex; gap: 8px; margin-top: 14px; }
    .wish-actions .btn-g { flex: 1; justify-content: center; padding: 11px 14px; font-size: .74rem; }
    .wish-remove {
      width: 44px; flex-shrink: 0; border: 1px solid var(--cream-dk); border-radius: 8px; background: var(--white);
      color: var(--muted); display: flex; align-items: center; justify-content: center; transition: all .2s;
    }
    .wish-remove:hover { border-color: #C0392B; color: #C0392B; background: rgba(192, 57, 43, .05); }
    .wish-remove .mi { font-size: 19px; }
    .wish-actions .btn-g[disabled], .wish-toolbar .btn-g[disabled] { opacity: .6; cursor: not-allowed; }
    /* Toolbar and grid stay hidden until we know whether anything is saved, so
       an empty wishlist never flashes a "0 fragrances saved" bar first. */
    .wish-toolbar[hidden], .wish-empty[hidden], .wish-loading[hidden] { display: none; }
    .wish-loading { text-align: center; padding: 44px 0; color: var(--warm); font-size: .9rem; }
    /* Empty state */
    .wish-empty { text-align: center; max-width: 520px; margin: 20px auto 0; padding: 40px 0; }
    .wish-empty .we-ic { width: 84px; height: 84px; border-radius: 50%; margin: 0 auto 22px; display: flex; align-items: center; justify-content: center; background: var(--cream-mid); border: 1px solid var(--cream-dk); }
    .wish-empty .we-ic .mi { font-size: 40px; color: var(--gold-dk); }
    .wish-empty h3 { font-family: var(--fd); font-weight: 400; font-size: 1.9rem; margin-bottom: 10px; }
    .wish-empty p { color: var(--warm); font-size: .92rem; margin-bottom: 24px; }
    /* Single-column on standard phones so Move-to-Cart + remove sit comfortably */
    @media (max-width: 560px) {
      #wishGrid { grid-template-columns: 1fr; gap: 16px; }
      /* minmax(0,1fr) rather than 1fr: a grid item defaults to min-width:auto,
         so the text column refused to shrink below its content and pushed the
         card wider than the screen instead — which clipped both the product
         name and the Move to Cart label rather than wrapping them. */
      .wish-card { display: grid; grid-template-columns: 112px minmax(0, 1fr); align-items: stretch; }
      /* The base card image is aspect-ratio:1. Combined with height:100% here
         the square constraint drove the width off the card's height instead of
         the 112px column, so the wrap overflowed its column — and because it is
         position:relative it painted over .prod-info, hiding the left of the
         title and the Move to Cart label. Pin both axes explicitly and drop the
         ratio: the grid row sets the height, the column sets the width. */
      .wish-card .prod-img-wrap { width: 100%; height: 100%; aspect-ratio: auto; min-width: 0; }
      .wish-card .prod-img { width: 100%; height: 100%; object-fit: cover; }
      .wish-card .prod-info { padding: 14px 14px 16px 16px; min-width: 0; }
      /* Titles here run long ("… | Black red"), and an unbroken run would
         reintroduce the overflow the column now allows for. */
      .wish-card .prod-name { font-size: 1rem; overflow-wrap: anywhere; }
      .wish-actions { min-width: 0; }
      .wish-actions .btn-g {
        min-width: 0; padding: 12px 10px; font-size: .68rem; letter-spacing: .06em; gap: 6px;
      }
      .wish-actions .btn-g .mi { font-size: 16px; }
      .wish-toolbar .btn-g { width: 100%; justify-content: center; }
    }
    /* Narrow phones: the label needs the ~22px the bag icon was taking. */
    @media (max-width: 400px) {
      .wish-card { grid-template-columns: 96px minmax(0, 1fr); }
      .wish-actions .btn-g { padding: 12px 6px; letter-spacing: .04em; }
      .wish-actions .btn-g .mi { display: none; }
      .wish-remove { width: 40px; }
    }
    </style>

    <div class="crumb-bar">
      <div class="container">
        <div class="breadcrumb"><a href="/">Home</a><span class="mi" aria-hidden="true">chevron_right</span><span>Wishlist</span></div>
      </div>
    </div>

    <section class="section" style="padding-top:44px">
      <div class="container">
        <div class="sec-head"><span class="label">Saved For Later</span><h2 class="sec-title">Your <em>Wishlist</em></h2></div>

        <div class="wish-toolbar" id="wishToolbar" hidden>
          <span class="wish-count"><b id="wishNum">0</b> <span id="wishNoun">fragrances</span> saved</span>
          <button class="btn-g" style="padding:12px 22px" id="wishAddAll" onclick="wishAddAllToCart(this)"><span class="mi" aria-hidden="true">shopping_bag</span>Add All to Cart</button>
        </div>

        <div class="wish-loading" id="wishLoading">Loading your saved fragrances…</div>

        <!-- SAVED ITEMS — built by the script below -->
        <div class="products-grid" id="wishGrid" hidden></div>

        <!-- EMPTY STATE -->
        <div class="wish-empty" id="wishEmpty" hidden>
          <div class="we-ic"><span class="mi" aria-hidden="true">favorite</span></div>
          <h3>Your wishlist is empty</h3>
          <p>Tap the heart on any fragrance to save it here for later. Start with our most-loved scents.</p>
          <div class="cta-actions" style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
            <a class="btn-g" href="/collections/best-sellers"><span class="mi" aria-hidden="true">local_fire_department</span>Shop Best Sellers</a>
            <a class="btn-ol" href="/pages/find-my-scent">Find My Scent</a>
          </div>
        </div>
      </div>
    </section>

    <!-- KEEP EXPLORING -->
    <section class="section alt">
      <div class="container">
        <div class="sec-head center fade-up"><span class="label">Keep Exploring</span><h2 class="sec-title">More to <em>Discover</em></h2></div>
        {%- if collections['featured'].products.size > 0 -%}<div class="products-grid">{%- for product in collections['featured'].products limit: 4 -%}{% render 'product-card', product: product %}{%- endfor -%}</div>{%- else -%}<div class="products-grid" data-render="products" data-count="4"></div>{%- endif -%}
      </div>
    </section>

  <script>
  (function () {
    var MONEY_FORMAT = {{ shop.money_format | json }};
    var FALLBACK_IMG = {{ 'prod-bouquet-oud.png' | asset_url | json }};

    /* Shopify's money filter runs server-side; these cards are built in the
       browser from /products/*.js, which returns cents. This covers the four
       placeholder forms a money_format can use, so the page follows whatever
       currency the store is set to instead of hardcoding one. */
    function money(cents) {
      var n = (cents || 0) / 100;
      function group(v, dec) {
        var parts = v.toFixed(dec).split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        return parts.join('.');
      }
      return MONEY_FORMAT.replace(/\{\{\s*(\w+)\s*\}\}/g, function (_, name) {
        switch (name) {
          case 'amount_no_decimals': return group(n, 0);
          case 'amount_with_comma_separator': return group(n, 2).replace(/,/g, ' ').replace('.', ',');
          case 'amount_no_decimals_with_comma_separator': return group(n, 0).replace(/,/g, ' ');
          default: return group(n, 2);
        }
      });
    }

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    var grid = document.getElementById('wishGrid');
    var toolbar = document.getElementById('wishToolbar');
    var empty = document.getElementById('wishEmpty');
    var loading = document.getElementById('wishLoading');

    function cardHTML(p) {
      var v = (p.variants && p.variants[0]) || {};
      var img = p.featured_image || (p.images && p.images[0]) || FALLBACK_IMG;
      var onSale = p.compare_at_price && p.compare_at_price > p.price;
      var save = onSale ? Math.round((p.compare_at_price - p.price) * 100 / p.compare_at_price) : 0;
      var title = esc(p.title);

      return '' +
        '<div class="prod-card wish-card fade-up" data-handle="' + esc(p.handle) + '" data-variant="' + (v.id || '') + '">' +
          '<a class="prod-img-wrap" href="' + esc(p.url) + '" style="display:block">' +
            '<img class="prod-img" src="' + esc(img) + '" alt="' + title + '" loading="lazy" width="600" height="600" />' +
            (onSale ? '<div class="prod-badge badge-sale">Save ' + save + '%</div>' : '') +
          '</a>' +
          '<div class="prod-info">' +
            (p.vendor ? '<div class="prod-brand">' + esc(p.vendor) + '</div>' : '') +
            '<div class="prod-name"><a href="' + esc(p.url) + '" style="color:inherit">' + title + '</a></div>' +
            '<div class="prod-price">' +
              '<span class="price-now">' + money(p.price) + '</span>' +
              (onSale ? '<span class="price-was">' + money(p.compare_at_price) + '</span>' +
                        '<span class="price-save">Save ' + save + '%</span>' : '') +
            '</div>' +
            '<div class="wish-actions">' +
              (v.available
                ? '<button class="btn-g" onclick="wishMoveToCart(this)"><span class="mi" aria-hidden="true">shopping_bag</span>Move to Cart</button>'
                : '<button class="btn-g" disabled><span class="mi" aria-hidden="true">shopping_bag</span>Sold Out</button>') +
              '<button class="wish-remove" title="Remove from wishlist" aria-label="Remove ' + title + ' from wishlist" onclick="wishRemove(this)"><span class="mi" aria-hidden="true">delete</span></button>' +
            '</div>' +
          '</div>' +
        '</div>';
    }

    function paint() {
      var n = grid.querySelectorAll('.wish-card').length;
      document.getElementById('wishNum').textContent = n;
      document.getElementById('wishNoun').textContent = n === 1 ? 'fragrance' : 'fragrances';
      toolbar.hidden = n === 0;
      empty.hidden = n !== 0;
      grid.hidden = n === 0;
    }

    /* One rule: the store changes, the grid redraws. An earlier version tracked
       which handles were drawn and skipped the redraw when it thought nothing
       had changed, and removals patched the DOM by hand — two sources of truth
       that could disagree. This keeps a single path.

       rendering/pending guard the re-entrancy that creates: render() drops
       handles that 404, which itself fires wishlist:change. */
    var rendering = false, pending = false;

    function done() {
      rendering = false;
      if (pending) { pending = false; render(); }
    }

    function render() {
      if (rendering) { pending = true; return; }
      rendering = true;

      var handles = window.TFSWishlist ? window.TFSWishlist.all() : [];
      if (!handles.length) {
        loading.hidden = true;
        grid.innerHTML = '';
        paint();
        done();
        return;
      }

      /* Fetched in parallel but rendered in saved order, so the grid does not
         reshuffle depending on which request happens to land first. */
      Promise.all(handles.map(function (h) {
        return fetch('/products/' + encodeURIComponent(h) + '.js', { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .catch(function () { return null; });
      })).then(function (products) {
        loading.hidden = true;
        products.forEach(function (p, i) {
          if (p === null && window.TFSWishlist) window.TFSWishlist.remove(handles[i]);
        });
        grid.innerHTML = products.filter(Boolean).map(cardHTML).join('');
        paint();
        done();
      }).catch(function () {
        loading.hidden = true;
        done();
      });
    }

    /* Saving from the Keep Exploring cards at the foot of this page, from
       another tab, or removing above — all land here. */
    document.addEventListener('wishlist:change', render);

    window.wishRemove = function (btn) {
      var card = btn.closest('.wish-card');
      var name = card.querySelector('.prod-name').textContent.trim();
      if (window.TFSWishlist) window.TFSWishlist.remove(card.getAttribute('data-handle'));
      if (typeof toast === 'function') toast('Removed — ' + name);
    };

    window.wishMoveToCart = function (btn) {
      var card = btn.closest('.wish-card');
      var name = card.querySelector('.prod-name').textContent.trim();
      btn.disabled = true;
      addCartItems([{ id: parseInt(card.getAttribute('data-variant'), 10), quantity: 1 }]).then(function (ok) {
        if (!ok) { btn.disabled = false; return; }
        if (window.TFSWishlist) window.TFSWishlist.remove(card.getAttribute('data-handle'));
        if (typeof toast === 'function') toast('✓ Moved to cart — ' + name);
      });
    };

    window.wishAddAllToCart = function (btn) {
      var cards = [].slice.call(grid.querySelectorAll('.wish-card')).filter(function (c) {
        var b = c.querySelector('.wish-actions .btn-g');
        return b && !b.disabled && c.getAttribute('data-variant');
      });
      if (!cards.length) { if (typeof toast === 'function') toast('Nothing available to add'); return; }

      btn.disabled = true;
      addCartItems(cards.map(function (c) {
        return { id: parseInt(c.getAttribute('data-variant'), 10), quantity: 1 };
      })).then(function (ok) {
        btn.disabled = false;
        if (!ok) return;
        cards.forEach(function (c) {
          if (window.TFSWishlist) window.TFSWishlist.remove(c.getAttribute('data-handle'));
        });
        if (typeof toast === 'function') toast('✓ ' + cards.length + ' fragrance' + (cards.length === 1 ? '' : 's') + ' moved to cart');
      });
    };

    /* One POST for the whole batch — /cart/add.js takes an items array, so
       "Add All" is a single request rather than one per card. */
    function addCartItems(items) {
      return fetch((window.routes && window.routes.cart_add_url) || '/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: items })
      }).then(function (r) { if (!r.ok) throw 0; return r.json(); })
        .then(function () {
          return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.json(); });
        })
        .then(function (c) {
          document.querySelectorAll('.cbadge').forEach(function (b) { b.textContent = c.item_count; });
          if (typeof cartCount !== 'undefined') cartCount = c.item_count;
          return true;
        })
        .catch(function () {
          if (typeof toast === 'function') toast('Could not add to cart — please try again');
          return false;
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', render);
    } else {
      render();
    }
  })();
  </script>

{% schema %}
{ "name": "Wishlist page", "settings": [] }
{% endschema %}
