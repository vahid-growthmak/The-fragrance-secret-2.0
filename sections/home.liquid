{%- comment -%}
  Homepage, rebuilt to the approved 13-section reference layout.

  Order: hero, trust bar, brands, best sellers, new arrivals, shop by category,
  shop by scent family, shop by moment (lifestyle + climate), guides, instagram,
  FAQ, why choose. The 10% welcome band is section 13 of the reference and is
  already rendered sitewide above the footer by customer-login-cta, so it is not
  duplicated here.

  Deliberately omitted from the reference: the review score, the "10,284 verified
  reviews" count, the named testimonials and the hero rating line, all of which
  are fabricated.

  Every card row resolves collections by handle and skips handles with no
  matching collection, so a tile can never link to a page that does not exist.
{%- endcomment -%}

{%- liquid
  assign house_handles = section.settings.house_handles | split: ','
  assign popular_handles = section.settings.popular_handles | split: ','
  assign category_handles = section.settings.category_handles | split: ','
  assign scent_handles = section.settings.scent_handles | split: ','
  assign lifestyle_handles = section.settings.lifestyle_handles | split: ','
  assign climate_handles = section.settings.climate_handles | split: ','
-%}

<!-- 1 · HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-content">
    <p class="hero-pretitle">{{ section.settings.hero_eyebrow }}</p>
    {%- comment -%}
      Two explicit lines rather than one string with a <br>: each is its own
      block, so the heading is always exactly two lines and never breaks into a
      third when the longer line outgrows the column.
    {%- endcomment -%}
    <h1 class="hero-h">
      <span class="hero-h-line">{{ section.settings.hero_line_1 }}</span>
      {%- if section.settings.hero_line_2 != blank -%}
        <span class="hero-h-line"><em>{{ section.settings.hero_line_2 }}</em></span>
      {%- endif -%}
    </h1>
    <p class="hero-sub">{{ section.settings.hero_sub }}</p>
    <div class="hero-ctas">
      <a class="btn-g" href="{{ section.settings.hero_cta_url }}">
        <span class="mi" aria-hidden="true">shopping_bag</span>{{ section.settings.hero_cta_label }}
      </a>
      <a class="hero-textlink" href="{{ section.settings.hero_link_url }}">{{ section.settings.hero_link_label }}
        <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>
  </div>
  <div class="hero-img-wrap">
    <img class="hero-img" src="{{ 'hero-roses.jpg' | asset_url }}"
      alt="Luxury perfume bottle among fresh roses" onload="this.classList.add('loaded')" />
  </div>
</section>

<!-- 2 · PERSISTENT TRUST BAR -->
<div class="trust-strip">
  <div class="trust-inner">
    <div class="ts-item"><span class="mi" aria-hidden="true">verified_user</span>
      <div><strong>100% Authentic</strong> — Verified sourcing</div>
    </div>
    <div class="ts-item"><span class="mi" aria-hidden="true">local_shipping</span>
      <div><strong>Free Delivery</strong> above AED 150</div>
    </div>
    <div class="ts-item"><span class="mi" aria-hidden="true">payments</span>
      <div><strong>Cash on Delivery</strong> available UAE-wide</div>
    </div>
    <div class="ts-item"><span class="mi" aria-hidden="true">chat</span>
      <div><strong>WhatsApp Support</strong> — daily 10am–7pm</div>
    </div>
  </div>
</div>

<!-- 3 · FEATURED BRANDS -->
<section class="brands" id="brands">
  <div class="brands-inner">
    <div class="best-head fade-up">
      <div>
        <span class="label">Shop by Brand</span>
        <h2 class="sec-title" style="font-size:1.9rem">{{ section.settings.brands_heading }}</h2>
      </div>
      <a href="/pages/brands" class="see-all">All Brands A–Z <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>

    {%- comment -%} Our own houses, elevated above the resale A-Z. {%- endcomment -%}
    <div class="ourbrands">
      {%- for raw_handle in house_handles -%}
        {%- assign house_handle = raw_handle | strip -%}
        {%- assign house = collections[house_handle] -%}
        {%- if house.handle == blank -%}{%- continue -%}{%- endif -%}
        {%- assign house_name = house.title | remove: ' Perfumes' -%}
        <a href="{{ house.url }}" class="ob-card fade-up">
          <span class="ob-tag">Our Brand</span>
          <span class="ob-name">{{ house_name }}</span>
          <span class="ob-sub">{{ house.description | strip_html | truncatewords: 6 }}</span>
          <span class="ob-go">Shop the house <span class="mi" aria-hidden="true">arrow_forward</span></span>
        </a>
      {%- endfor -%}
    </div>

    {%- comment -%} Most-loved houses, then the full A-Z on the brands hub. {%- endcomment -%}
    <div class="azbrands-head fade-up">
      <span class="label" style="margin:0">Most Loved Houses</span>
      <span class="az-note">Verified Resale</span>
    </div>
    <div class="brand-cloud brand-cloud-row fade-up">
      {%- for raw_handle in popular_handles -%}
        {%- assign popular_handle = raw_handle | strip -%}
        {%- assign brand = collections[popular_handle] -%}
        {%- if brand.handle == blank -%}{%- continue -%}{%- endif -%}
        <a class="brand-chip" href="{{ brand.url }}">
          {{ brand.title | remove: ' Perfumes' }}
          {%- if brand.products_count > 0 -%}<span class="brand-chip-n">{{ brand.products_count }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
      <a class="brand-chip brand-chip-all" href="/pages/brands">View all brands
        <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>
  </div>
</section>

<!-- 4 · BEST SELLERS -->
<section class="best" id="best">
  <div class="best-inner">
    <div class="best-head fade-up">
      <div>
        <span class="label">Most Popular</span>
        <h2 class="sec-title">The Best Perfumes in UAE<br>Loved by <em>Our Customers</em></h2>
      </div>
      <a href="/collections/best-sellers" class="see-all">View All <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>
    {%- assign bestsellers = collections['best-sellers'] -%}
    {%- if bestsellers.products.size == 0 -%}{%- assign bestsellers = collections['featured'] -%}{%- endif -%}
    {%- if bestsellers.products.size > 0 -%}
      <div class="products-grid">
        {%- for product in bestsellers.products limit: 4 -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<!-- 5 · NEW ARRIVALS -->
<section class="best" id="new">
  <div class="best-inner">
    <div class="best-head fade-up">
      <div>
        <span class="label">New Arrivals</span>
        <h2 class="sec-title">Premium Fragrances <em>Newly Added for You</em></h2>
        <p class="sec-sub">Explore our fresh arrivals featuring new scents that feel unique, elegant, and memorable —
          fragrances that match every mood, style, and occasion.</p>
      </div>
      <a href="/collections/new-arrivals" class="see-all">View All <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>
    {%- if collections['new-arrivals'].products.size > 0 -%}
      <div class="products-grid">
        {%- for product in collections['new-arrivals'].products limit: 4 -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<!-- 6 · SHOP BY CATEGORY -->
<section class="gender" id="category">
  <div class="gender-inner">
    <div class="best-head fade-up">
      <div>
        <span class="label">Shop by Category</span>
        <h2 class="sec-title">Start With <em>Who It's For</em></h2>
        <p class="sec-sub">The fastest way in. Most shoppers know the person before the perfume, so we lead with it.</p>
      </div>
      <a href="/collections" class="see-all">Explore All Categories <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>
    <div class="gender-grid six">
      {%- for raw_handle in category_handles -%}
        {%- assign category_handle = raw_handle | strip -%}
        {%- assign category = collections[category_handle] -%}
        {%- if category.handle == blank -%}{%- continue -%}{%- endif -%}
        {%- assign category_image = category.image | default: category.products.first.featured_image -%}
        <a class="g-card fade-up" href="{{ category.url }}">
          {%- if category_image -%}
            <img class="gc-img" src="{{ category_image | image_url: width: 600 }}"
                 alt="{{ category.title | escape }}" loading="lazy" />
          {%- endif -%}
          <div class="gc-overlay"></div>
          <div class="gc-content">
            <div class="gc-title">{{ category.title | remove: ' Perfumes' }}</div>
            {%- if category.products_count > 0 -%}
              <div class="gc-count">{{ category.products_count }} Fragrance{% if category.products_count != 1 %}s{% endif %}</div>
            {%- endif -%}
            <span class="gc-btn">Explore</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- 7 · SHOP BY SCENT FAMILY -->
<section class="scent-section" id="scent-family">
  <div class="container">
    <div class="sec-head center fade-up">
      <span class="label">Shop by Scent Family</span>
      <h2 class="sec-title">Find Your <em>Signature Note</em></h2>
      <p class="sec-sub">Don't know the name, but you know what you love. Pick the family that speaks to you.</p>
    </div>
    <div class="scent-grid">
      {%- for block in section.blocks -%}
        {%- if block.type != 'scent' -%}{%- continue -%}{%- endif -%}
        {%- assign scent = collections[block.settings.handle] -%}
        {%- if scent.handle == blank -%}{%- continue -%}{%- endif -%}
        <a class="scent-card fade-up" href="{{ scent.url }}" {{ block.shopify_attributes }}>
          <span class="scent-ic"><span class="mi" aria-hidden="true">{{ block.settings.icon }}</span></span>
          <h3>{{ block.settings.title | default: scent.title }}</h3>
          <p>{{ block.settings.sub }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- 8 · SHOP BY MOMENT -->
<section class="moment-section" id="moment">
  <div class="container">
    <div class="sec-head center fade-up">
      <span class="label">Shop by Moment</span>
      <h2 class="sec-title" style="color:var(--white)">Perfume For <em>Where You're Headed</em></h2>
      <p class="sec-sub">Match a scent to the moment or the weather — two more ways in for shoppers who don't know names.</p>
    </div>
    <div class="moment-wrap">
      {%- comment -%} Two columns: lifestyle and climate, six tiles each. {%- endcomment -%}
      {%- assign moment_cols = 'lifestyle,climate' | split: ',' -%}
      {%- for col in moment_cols -%}
        {%- if col == 'lifestyle' -%}
          {%- assign col_handles = lifestyle_handles -%}
          {%- assign col_title = 'By Lifestyle' -%}
          {%- assign col_lead = 'Dress your scent for the occasion.' -%}
          {%- assign col_all_label = 'All lifestyles' -%}
          {%- assign col_all_url = '/pages/shop-by-lifestyle' -%}
        {%- else -%}
          {%- assign col_handles = climate_handles -%}
          {%- assign col_title = 'By Climate' -%}
          {%- assign col_lead = 'Built for UAE heat, and beyond.' -%}
          {%- assign col_all_label = 'All climates' -%}
          {%- assign col_all_url = '/pages/shop-by-weather' -%}
        {%- endif -%}
        <div class="moment-col">
          <h3 class="moment-title">{{ col_title }}</h3>
          <p class="moment-lead">{{ col_lead }}</p>
          <div class="moment-tiles">
            {%- for raw_handle in col_handles -%}
              {%- assign moment_handle = raw_handle | strip -%}
              {%- assign moment = collections[moment_handle] -%}
              {%- if moment.handle == blank -%}{%- continue -%}{%- endif -%}
              {%- assign moment_image = moment.image | default: moment.products.first.featured_image -%}
              <a class="moment-tile" href="{{ moment.url }}">
                {%- if moment_image -%}
                  <img src="{{ moment_image | image_url: width: 400 }}"
                       alt="{{ moment.title | escape }}" loading="lazy">
                {%- endif -%}
                <span>{{ moment.title | remove: ' Perfumes' }}</span>
              </a>
            {%- endfor -%}
          </div>
          <a class="see-all moment-all" href="{{ col_all_url }}">{{ col_all_label }}
            <span class="mi" aria-hidden="true">arrow_forward</span></a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- 9 · GUIDES -->
<section class="blog" id="blog">
  <div class="blog-inner">
    <div class="blog-head fade-up">
      <div>
        <span class="label">Know Before You Buy</span>
        <h2 class="sec-title">Fragrance Insights &amp; <em>Expert Guides</em></h2>
      </div>
      <a href="/blogs/journal" class="see-all">All Articles <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>
    {%- if blogs['journal'].articles.size > 0 -%}
      <div class="blog-grid">
        {%- for article in blogs['journal'].articles limit: 3 -%}
          <a class="bl-card" href="{{ article.url }}">
            <div class="bl-img-wrap">{% if article.image %}<img class="bl-img" src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" loading="lazy">{% endif %}</div>
            {% if article.tags.size > 0 %}<div class="bl-cat">{{ article.tags.first }}</div>{% endif %}
            <div class="bl-title">{{ article.title }}</div>
            <div class="bl-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</div>
            <div class="bl-meta">{{ article.published_at | date: '%B %-d, %Y' }}</div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<!-- 10 · INSTAGRAM -->
<section class="ugc">
  <div class="ugc-inner">
    <div class="ugc-head fade-up">
      <span class="label">Insta Shop</span>
      <h2 class="sec-title">Real People. <em>Real Scents.</em></h2>
      <p class="sec-sub center" style="margin:8px auto 0">Tag us @thefragrancesecrets to be featured</p>
    </div>
    <div class="ugc-grid" data-render="ugc"></div>
  </div>
</section>

<!-- 11 · FAQ -->
<section class="faq" id="faq">
  <div class="faq-inner">
    <div class="faq-head fade-up">
      <span class="label">Your Questions, Answered</span>
      <h2 class="sec-title">Frequently Asked <em>Questions</em></h2>
    </div>
    <div class="faq-list fade-up">
      {%- for block in section.blocks -%}
        {%- if block.type != 'faq' -%}{%- continue -%}{%- endif -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary class="faq-q">{{ block.settings.question }}<span class="mi" aria-hidden="true">add</span></summary>
          <div class="faq-a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- 12 · WHY CHOOSE THE FRAGRANCE SECRETS -->
<section class="section why-section">
  <div class="container">
    <div class="sec-head center fade-up">
      <span class="label">Why Shop With Us</span>
      <h2 class="sec-title">Why Choose <em>The Fragrance Secrets</em></h2>
      {%- if section.settings.why_sub != blank -%}
        <p class="sec-sub">{{ section.settings.why_sub }}</p>
      {%- endif -%}
    </div>
    <div class="why-grid">
      {%- for block in section.blocks -%}
        {%- if block.type != 'why' -%}{%- continue -%}{%- endif -%}
        <div class="why-card fade-up" {{ block.shopify_attributes }}>
          <span class="mi" aria-hidden="true">{{ block.settings.icon }}</span>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%}
  Section 13 of the reference, the 10% welcome band, is rendered sitewide above
  the footer by sections/customer-login-cta.liquid, so it is not repeated here.
{%- endcomment -%}

{% schema %}
{
  "name": "Home",
  "settings": [
    { "type": "header", "content": "1 · Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Luxury Perfumes · UAE" },
    { "type": "text", "id": "hero_line_1", "label": "Heading line 1", "default": "Find The Scent That" },
    { "type": "text", "id": "hero_line_2", "label": "Heading line 2",
      "info": "Rendered italic in gold on its own line. Leave blank for a one-line heading.",
      "default": "Feels Truly Yours" },
    { "type": "textarea", "id": "hero_sub", "label": "Subheading",
      "default": "Authentic designer, Arabic and oud fragrances, curated in one trusted UAE destination." },
    { "type": "text", "id": "hero_cta_label", "label": "Button label", "default": "Shop Perfumes" },
    { "type": "url", "id": "hero_cta_url", "label": "Button link" },
    { "type": "text", "id": "hero_link_label", "label": "Text link label", "default": "or explore best sellers" },
    { "type": "url", "id": "hero_link_url", "label": "Text link" },

    { "type": "header", "content": "3 · Brands" },
    { "type": "html", "id": "brands_heading", "label": "Heading",
      "default": "Our Houses &amp; <em>World Brands</em>" },
    { "type": "textarea", "id": "house_handles", "label": "Our own houses (comma separated handles)",
      "info": "Handles with no matching collection are skipped. 'secret-scents' has no collection yet — add it here once it does.",
      "default": "fragrance-secrets, paris-collection" },
    { "type": "textarea", "id": "popular_handles", "label": "Most loved houses (comma separated handles)",
      "default": "lattafa, rasasi, armaf, swiss-arabian, ahmed-al-maghribi, al-haramain, amouage, ibrahim-al-qurashi" },

    { "type": "header", "content": "6 · Shop by category" },
    { "type": "textarea", "id": "category_handles", "label": "Category collections (comma separated handles)",
      "default": "mens, womens, unisex, kids, arabic, perfume-oil" },

    { "type": "header", "content": "8 · Shop by moment" },
    { "type": "textarea", "id": "lifestyle_handles", "label": "Lifestyle collections (comma separated handles)",
      "default": "office-wear, date-night, wedding, gym, travel-friendly, dinner-evening" },
    { "type": "textarea", "id": "climate_handles", "label": "Climate collections (comma separated handles)",
      "default": "summer-wear, winter-holiday, desert-climate, humid-weather, tropical-climate, rainy-day" },

    { "type": "header", "content": "12 · Why choose" },
    { "type": "textarea", "id": "why_sub", "label": "Intro",
      "info": "The reference marks this section as a copy placeholder pending the approved homepage document. The cards below default to the wording already signed off in the collection documents." }
  ],
  "blocks": [
    {
      "type": "scent",
      "name": "Scent family",
      "settings": [
        { "type": "text", "id": "handle", "label": "Collection handle" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "text", "id": "sub", "label": "Description" },
        { "type": "text", "id": "icon", "label": "Material icon name", "default": "spa" }
      ]
    },
    {
      "type": "why",
      "name": "Why choose card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Material icon name", "default": "verified" },
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home",
      "blocks": [
        { "type": "scent", "settings": { "handle": "oud-woody", "title": "Oud & Woody", "sub": "Deep, warm, resinous", "icon": "park" } },
        { "type": "scent", "settings": { "handle": "fresh-citrus", "title": "Fresh & Citrus", "sub": "Bright, clean, energetic", "icon": "water_drop" } },
        { "type": "scent", "settings": { "handle": "floral-rose", "title": "Floral & Rose", "sub": "Elegant, soft, romantic", "icon": "local_florist" } },
        { "type": "scent", "settings": { "handle": "sweet-gourmand", "title": "Sweet & Gourmand", "sub": "Rich, indulgent, cosy", "icon": "cake" } },
        { "type": "scent", "settings": { "handle": "spicy-oriental", "title": "Spicy & Oriental", "sub": "Bold, warm, exotic", "icon": "local_fire_department" } },
        { "type": "why", "settings": { "icon": "verified", "title": "100% Authentic Perfumes", "body": "Every fragrance is genuine and sourced through trusted suppliers, checked before it ships." } },
        { "type": "why", "settings": { "icon": "local_shipping", "title": "Fast UAE Delivery", "body": "Quick delivery across Dubai, Abu Dhabi, Sharjah and the wider Emirates." } },
        { "type": "why", "settings": { "icon": "lock", "title": "Secure Payments", "body": "Pay safely by card, wallet or cash on delivery, whichever suits you best." } },
        { "type": "why", "settings": { "icon": "diamond", "title": "Premium Fragrance Collection", "body": "Designer houses and Arabian perfumery, side by side in one place." } },
        { "type": "faq", "settings": { "question": "What are the best luxury perfumes to buy online in UAE?", "answer": "At The Fragrance Secrets, you can explore a premium collection of luxury perfumes carefully selected for fragrance lovers across the UAE. From signature scents to exclusive designer fragrances, we offer authentic perfumes that combine quality, elegance, and long-lasting performance for every occasion." } },
        { "type": "faq", "settings": { "question": "How do I choose the right perfume for my personality?", "answer": "Choosing the right perfume depends on your personal style, mood, and fragrance preferences. Whether you prefer floral, woody, fresh, or oriental scents, The Fragrance Secrets helps you discover fragrances that match your personality and create a lasting impression wherever you go." } },
        { "type": "faq", "settings": { "question": "Where can I buy authentic perfumes online in Dubai?", "answer": "If you are looking for authentic perfumes online in Dubai, The Fragrance Secrets offers a trusted destination for premium fragrance shopping. Our collection includes carefully sourced perfumes designed for those who value originality, luxury, and a seamless online shopping experience." } },
        { "type": "faq", "settings": { "question": "Which perfumes last longer in UAE weather conditions?", "answer": "Long-lasting perfumes in UAE weather usually include fragrances with oud, amber, musk, and woody notes because they perform well in warm climates. At The Fragrance Secrets, we offer premium fragrances specially chosen for durability, richness, and all-day freshness in the UAE environment." } },
        { "type": "faq", "settings": { "question": "Why should I buy perfumes from The Fragrance Secrets?", "answer": "The Fragrance Secrets is dedicated to offering authentic premium fragrances for customers who appreciate quality and luxury. With carefully curated perfume collections, trusted sourcing, and a focus on premium fragrance experiences, we help customers discover scents that feel personal, memorable, and timeless." } }
      ]
    }
  ]
}
{% endschema %}
