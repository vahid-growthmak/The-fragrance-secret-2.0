{%- comment -%}
  Homepage, rebuilt to the approved 13-section reference layout.

  Order: hero, trust bar, brands, best sellers, new arrivals, shop by category,
  shop by scent family, shop by moment (lifestyle + climate), guides, instagram,
  FAQ, why choose. The 10% welcome band is section 13 of the reference and is
  already rendered sitewide above the footer by customer-login-cta, so it is not
  duplicated here.

  Deliberately omitted from the reference: the review score, the "10,284 verified
  reviews" count, the named testimonials and the hero rating line, all of which
  are fabricated.

  Every card row resolves collections by handle and skips handles with no
  matching collection, so a tile can never link to a page that does not exist.
{%- endcomment -%}

{%- liquid
  assign house_handles = section.settings.house_handles | split: ','
  assign popular_handles = section.settings.popular_handles | split: ','
-%}

<!-- 1 · HERO -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-content">
    {%- if section.settings.hero_eyebrow != blank -%}
      <h1 class="hero-pretitle">{{ section.settings.hero_eyebrow }}</h1>
    {%- endif -%}
    {%- comment -%}
      Display copy, not the H1 — the eyebrow above carries that now, so this is a
      div and the page keeps a single H1. Each line is its own block rather than
      one string with a <br>, so the split is deliberate and never becomes three
      lines when the longer one outgrows the column.
    {%- endcomment -%}
    <div class="hero-h">
      <span class="hero-h-line">{{ section.settings.hero_line_1 }}</span>
      {%- if section.settings.hero_line_2 != blank -%}
        <span class="hero-h-line"><em>{{ section.settings.hero_line_2 }}</em></span>
      {%- endif -%}
    </div>
    {%- if section.settings.hero_tagline != blank or section.settings.hero_tagline_2 != blank -%}
      <p class="hero-tagline">
        {%- if section.settings.hero_tagline != blank -%}
          <span class="hero-tagline-line">{{ section.settings.hero_tagline }}</span>
        {%- endif -%}
        {%- if section.settings.hero_tagline_2 != blank -%}
          <span class="hero-tagline-line">{{ section.settings.hero_tagline_2 }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}
    <p class="hero-sub">{{ section.settings.hero_sub }}</p>
    <div class="hero-ctas">
      {%- comment -%}
        Fallbacks matter here: a url setting cannot carry an arbitrary schema
        default, so an unset one renders href="" — a link that silently reloads
        the page instead of going anywhere.
      {%- endcomment -%}
      <a class="btn-g" href="{{ section.settings.hero_cta_url | default: routes.all_products_collection_url }}">
        <span class="mi" aria-hidden="true">shopping_bag</span>{{ section.settings.hero_cta_label }}
      </a>
      <a class="hero-textlink" href="{{ section.settings.hero_link_url | default: '/collections/best-sellers' }}">{{ section.settings.hero_link_label }}
        <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>
    {%- comment -%}
      Hidden under 900px, where the trust bar directly below the hero carries the
      same reassurance without crowding a small screen.
    {%- endcomment -%}
    <div class="hero-trust">
      <div class="ht-item"><span class="mi" aria-hidden="true">verified_user</span>100% Authentic &amp; Verified Sourcing</div>
      <div class="ht-item"><span class="mi" aria-hidden="true">diamond</span>Premium Fragrance Collection</div>
      <div class="ht-item"><span class="mi" aria-hidden="true">support_agent</span>
        <span class="ht-text">Customer Support<span>Daily 10 AM – 7 PM (UAE Time)</span></span>
      </div>
      <div class="ht-item"><span class="mi" aria-hidden="true">payments</span>Cash on Delivery Across UAE</div>
    </div>
  </div>
  <div class="hero-img-wrap">
    {%- comment -%}
      Full-bleed artwork. Uploaded images are served through image_url so Shopify
      generates the responsive sizes; the packaged asset is the fallback.
    {%- endcomment -%}
    {%- assign hero_image = section.settings.hero_image -%}
    {%- if hero_image != blank -%}
      <img class="hero-img"
        src="{{ hero_image | image_url: width: 2880 }}"
        srcset="{{ hero_image | image_url: width: 900 }} 900w,
                {{ hero_image | image_url: width: 1400 }} 1400w,
                {{ hero_image | image_url: width: 1900 }} 1900w,
                {{ hero_image | image_url: width: 2400 }} 2400w,
                {{ hero_image | image_url: width: 2880 }} 2880w"
        sizes="100vw"
        width="{{ hero_image.width }}" height="{{ hero_image.height }}"
        style="object-position: {{ section.settings.hero_focus }}"
        alt="{{ hero_image.alt | default: 'Luxury perfume' | escape }}"
        fetchpriority="high" onload="this.classList.add('loaded')" />
    {%- else -%}
      {%- assign hero_asset = section.settings.hero_image_asset | default: 'home-hero.webp' -%}
      <img class="hero-img" src="{{ hero_asset | asset_url }}"
        {%- if section.settings.hero_image_asset_sm != blank %}
        srcset="{{ section.settings.hero_image_asset_sm | asset_url }} 900w, {{ hero_asset | asset_url }} 1672w"
        sizes="100vw"
        {%- endif %}
        style="object-position: {{ section.settings.hero_focus }}"
        alt="{{ section.settings.hero_image_alt | escape }}"
        fetchpriority="high" onload="this.classList.add('loaded')" />
    {%- endif -%}
  </div>
</section>

<!-- 2 · FEATURED BRANDS -->
<section class="brands" id="brands">
  <div class="brands-inner">
    <div class="best-head fade-up">
      <div>
        <span class="label">{{ section.settings.brands_eyebrow }}</span>
        <h2 class="sec-title" style="font-size:1.9rem">{{ section.settings.brands_heading }}</h2>
        {%- if section.settings.brands_sub != blank -%}<p class="sec-sub">{{ section.settings.brands_sub }}</p>{%- endif -%}
      </div>
      <a href="/pages/brands" class="see-all">View All Brands <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>

    {%- comment -%} Our own houses, elevated above the resale A-Z. {%- endcomment -%}
    <div class="ourbrands">
      {%- for raw_handle in house_handles -%}
        {%- assign house_handle = raw_handle | strip -%}
        {%- assign house = collections[house_handle] -%}
        {%- if house.handle == blank -%}{%- continue -%}{%- endif -%}
        {%- assign house_name = house.title | remove: ' Perfumes' -%}
        <a href="{{ house.url }}" class="ob-card fade-up">
          {%- comment -%}
            The collection's own banner, phone variant, sits behind the copy.
            Liquid cannot test whether a theme asset exists, so a missing one
            removes itself and the card falls back to its plain gradient.
          {%- endcomment -%}
          {%- assign house_banner = house.handle | append: '-hero-sm.webp' -%}
          <img class="ob-img" src="{{ house_banner | asset_url }}" alt=""
               onerror="this.remove()" loading="lazy" width="1200" height="417">
          <span class="ob-tag">Our Brand</span>
          <span class="ob-name">{{ house_name }}</span>
          <span class="ob-sub">{{ house.description | strip_html | truncatewords: 6 }}</span>
          <span class="ob-go">Shop the house <span class="mi" aria-hidden="true">arrow_forward</span></span>
        </a>
      {%- endfor -%}
    </div>

    {%- comment -%}
      House browser. One tab per brand block, each panel a four-up product row
      in the same shape as Best Sellers — so a shopper can compare houses in
      place instead of scrolling past six near-identical sections.

      Driven by the same `brand` blocks the editor already manages, so adding
      or reordering a house is a block change, not a code change. A block whose
      collection is empty or misspelled drops out entirely rather than
      rendering an empty tab.
    {%- endcomment -%}
    {%- comment -%}
      Counted with an explicit loop rather than `where: 'type', 'brand'`, so
      the wrapper only renders when at least one house actually has products.
    {%- endcomment -%}
    {%- assign bt_total = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type != 'brand' -%}{%- continue -%}{%- endif -%}
      {%- assign bt_coll = collections[block.settings.handle] -%}
      {%- if bt_coll.products.size > 0 -%}{%- assign bt_total = bt_total | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if bt_total > 0 -%}
    <div class="brandtabs fade-up">
      <div class="bt-tabs" role="tablist" aria-label="Shop by house">
        {%- assign bt_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'brand' -%}{%- continue -%}{%- endif -%}
          {%- assign bt_coll = collections[block.settings.handle] -%}
          {%- if bt_coll.products.size == 0 -%}{%- continue -%}{%- endif -%}
          {%- assign bt_i = bt_i | plus: 1 -%}
          {%- assign bt_name = bt_coll.title | remove: ' Perfumes' -%}
          <button type="button"
                  class="bt-tab{% if bt_i == 1 %} active{% endif %}"
                  role="tab"
                  id="bt-tab-{{ block.settings.handle | handle }}"
                  aria-controls="bt-panel-{{ block.settings.handle | handle }}"
                  aria-selected="{% if bt_i == 1 %}true{% else %}false{% endif %}"
                  onclick="switchBrandTab(this)">{{ bt_name }}</button>
        {%- endfor -%}
      </div>

      {%- assign bt_j = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'brand' -%}{%- continue -%}{%- endif -%}
        {%- assign bt_coll = collections[block.settings.handle] -%}
        {%- if bt_coll.products.size == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign bt_j = bt_j | plus: 1 -%}
        {%- assign bt_name = bt_coll.title | remove: ' Perfumes' -%}
        {%- assign bt_count = block.settings.count | default: 4 -%}
        <div class="bt-panel{% if bt_j == 1 %} active{% endif %}"
             id="bt-panel-{{ block.settings.handle | handle }}"
             role="tabpanel"
             aria-labelledby="bt-tab-{{ block.settings.handle | handle }}"
             {% unless bt_j == 1 %}hidden{% endunless %}>
          <div class="bt-panel-head">
            {%- if block.settings.sub != blank -%}
              <p class="bt-sub">{{ block.settings.sub }}</p>
            {%- else -%}<span></span>{%- endif -%}
            <a href="{{ bt_coll.url }}" class="bt-viewall">View all {{ bt_name }}</a>
          </div>
          {%- comment -%}
            A hand-picked list wins over the collection's own order, which is
            "most relevant" and so decides for itself which four of sixty-eight
            products represent the house. Leave the picker empty and the
            collection order applies as before.
          {%- endcomment -%}
          {%- assign bt_items = block.settings.products -%}
          {%- if bt_items.size == 0 -%}{%- assign bt_items = bt_coll.products -%}{%- endif -%}
          <div class="products-grid">
            {%- for product in bt_items limit: bt_count -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}

  </div>
</section>

<!-- 3 · BEST SELLERS -->
<section class="best" id="best">
  <div class="best-inner">
    <div class="best-head fade-up">
      <div>
        <span class="label">{{ section.settings.best_eyebrow }}</span>
        <h2 class="sec-title">{{ section.settings.best_heading }}</h2>
        {%- if section.settings.best_sub != blank -%}<p class="sec-sub">{{ section.settings.best_sub }}</p>{%- endif -%}
      </div>
      <a href="/collections/best-sellers" class="see-all">View All <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>
    {%- assign bestsellers = collections['best-sellers'] -%}
    {%- if bestsellers.products.size == 0 -%}{%- assign bestsellers = collections['featured'] -%}{%- endif -%}
    {%- if bestsellers.products.size > 0 -%}
      <div class="products-grid">
        {%- for product in bestsellers.products limit: 4 -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<!-- 4 · NEW ARRIVALS -->
<section class="best" id="new">
  <div class="best-inner">
    <div class="best-head fade-up">
      <div>
        <span class="label">{{ section.settings.new_eyebrow }}</span>
        <h2 class="sec-title">{{ section.settings.new_heading }}</h2>
        {%- if section.settings.new_sub != blank -%}<p class="sec-sub">{{ section.settings.new_sub }}</p>{%- endif -%}
      </div>
      <a href="/collections/new-arrivals" class="see-all">View All <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>
    {%- if collections['new-arrivals'].products.size > 0 -%}
      <div class="products-grid">
        {%- for product in collections['new-arrivals'].products limit: 4 -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<!-- 5 · FEATURED PRODUCT -->
{%- comment -%}
  Single-product spotlight. The styles for this block (.fp-split, .fp-gallery,
  .fp-thumbs, .fp-btn-add ...) and its two JS handlers (swapFpImg, changeFpQty,
  keyed to #fp-main-img and #fp-qty) both survived the port from the static
  prototype in assets/theme.css and assets/app.js — only the markup was lost,
  so this restores it against the contract that was already there.

  Placed between New Arrivals and the brand rows: it breaks the run of four-up
  grids with a single-product moment rather than stacking eight of them.

  Add to cart posts the real product form and Buy it now is Shopify's dynamic
  checkout button, so this behaves like the PDP, not a decorative panel.
{%- endcomment -%}
{%- for block in section.blocks -%}
  {%- if block.type != 'featured_product' -%}{%- continue -%}{%- endif -%}
  {%- assign fp = block.settings.product -%}
  {%- if fp == blank -%}{%- continue -%}{%- endif -%}
  {%- assign fpv = fp.selected_or_first_available_variant -%}
  <section class="best best-tint" id="featured-product" {{ block.shopify_attributes }}>
    <div class="best-inner">
      {%- if block.settings.heading != blank or block.settings.eyebrow != blank -%}
      <div class="best-head fade-up">
        <div>
          {%- if block.settings.eyebrow != blank -%}<span class="label">{{ block.settings.eyebrow }}</span>{%- endif -%}
          {%- if block.settings.heading != blank -%}<h2 class="sec-title">{{ block.settings.heading }}</h2>{%- endif -%}
          {%- if block.settings.sub != blank -%}<p class="sec-sub">{{ block.settings.sub }}</p>{%- endif -%}
        </div>
        <a href="{{ fp.url }}" class="see-all">View Product <span class="mi" aria-hidden="true">arrow_forward</span></a>
      </div>
      {%- endif -%}

      {%- form 'product', fp, id: 'featured-product-form' -%}
        <input type="hidden" name="id" value="{{ fpv.id }}">
        <div class="fp-split fade-up">

          <div class="fp-gallery">
            <div class="fp-main-wrap">
              {%- if fp.featured_media -%}
                <img id="fp-main-img" src="{{ fp.featured_media | image_url: width: 900 }}" alt="{{ fp.title | escape }}" width="900" height="900" loading="lazy">
              {%- else -%}
                <img id="fp-main-img" src="{{ 'prod-bouquet-oud.png' | asset_url }}" alt="{{ fp.title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            {%- if fp.media.size > 1 -%}
            <div class="fp-thumbs">
              {%- for media in fp.media limit: 5 -%}
                <div class="fp-thumb{% if forloop.first %} active{% endif %}"
                     onclick="swapFpImg(this, '{{ media | image_url: width: 900 }}')">
                  <img src="{{ media | image_url: width: 200 }}" alt="{{ fp.title | escape }} view {{ forloop.index }}" loading="lazy">
                </div>
              {%- endfor -%}
            </div>
            {%- endif -%}
          </div>

          <div class="fp-details">
            {%- if fp.vendor != blank -%}<div class="fp-brand">{{ fp.vendor }}</div>{%- endif -%}
            <h3 class="fp-title">{{ fp.title }}</h3>

            <div class="fp-price-block">
              <span class="fp-price">{{ fpv.price | money }}</span>
              {%- if fpv.compare_at_price > fpv.price -%}
                <span class="fp-compare">{{ fpv.compare_at_price | money }}</span>
                <span class="fp-badge">On sale</span>
              {%- endif -%}
            </div>
            <div class="fp-tax">Tax included.</div>
            <hr class="fp-divider">

            <label class="fp-qty-label" for="fp-qty">Quantity</label>
            <div class="fp-qty-row">
              <div class="fp-qty-wrap">
                <button type="button" onclick="changeFpQty(-1)" aria-label="Decrease quantity">&minus;</button>
                <input id="fp-qty" name="quantity" type="text" value="1" inputmode="numeric" aria-label="Quantity">
                <button type="button" onclick="changeFpQty(1)" aria-label="Increase quantity">+</button>
              </div>
              <svg class="fp-share-icon" viewBox="0 0 24 24" role="button" tabindex="0"
                   aria-label="Share this product"
                   onclick="if(navigator.share){navigator.share({title:{{ fp.title | json }},url:'{{ shop.url }}{{ fp.url }}'})}else if(navigator.clipboard){navigator.clipboard.writeText('{{ shop.url }}{{ fp.url }}')}">
                <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
                <line x1="8.6" y1="10.5" x2="15.4" y2="6.5"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/>
              </svg>
            </div>

            <button type="submit" name="add" class="fp-btn-add"{% unless fpv.available %} disabled{% endunless %}>
              <span class="mi" aria-hidden="true">shopping_bag</span>{% if fpv.available %}Add to cart{% else %}Sold out{% endif %}
            </button>
            {{ form | payment_button }}
            <a href="{{ fp.url }}" class="fp-link-bold">View full details</a>
          </div>

        </div>
      {%- endform -%}
    </div>
  </section>
{%- endfor -%}

<!-- 6 · SHOP BY CATEGORY -->
<section class="gender" id="category">
  <div class="gender-inner">
    <div class="best-head fade-up">
      <div>
        <span class="label">{{ section.settings.category_eyebrow }}</span>
        <h2 class="sec-title">{{ section.settings.category_heading }}</h2>
        {%- if section.settings.category_sub != blank -%}<p class="sec-sub">{{ section.settings.category_sub }}</p>{%- endif -%}
      </div>
      <a href="/pages/shop-by-category" class="see-all">Explore All Categories <span class="mi" aria-hidden="true">arrow_forward</span></a>
    </div>
    {%- comment -%}
      Landscape image cards: title plus one descriptor line, and an arrow on
      hover. The descriptor is per-card copy where the collection needs one
      ("Oud, musk & attar"), and falls back to the live product count.
      An uploaded image wins, then the collection image, then its first product.
    {%- endcomment -%}
    <div class="cat-grid">
      {%- for block in section.blocks -%}
        {%- if block.type != 'category' -%}{%- continue -%}{%- endif -%}
        {%- assign category = collections[block.settings.handle] -%}
        {%- if category.handle == blank -%}{%- continue -%}{%- endif -%}
        {%- assign cat_asset = block.settings.image_asset -%}
        {%- assign cat_image = block.settings.image | default: category.image | default: category.products.first.featured_image -%}
        {%- assign cat_title = block.settings.title | default: category.title -%}
        {%- assign cat_sizes = '(max-width: 600px) 92vw, (max-width: 900px) 46vw, 30vw' -%}
        <a class="cat-card fade-up" href="{{ category.url }}" {{ block.shopify_attributes }}>
          {%- if cat_asset != blank -%}
            <img class="cat-img" src="{{ cat_asset | asset_url }}"
                 {%- if block.settings.image_asset_sm != blank %}
                 srcset="{{ block.settings.image_asset_sm | asset_url }} 600w, {{ cat_asset | asset_url }} 1200w"
                 sizes="{{ cat_sizes }}"
                 {%- endif %}
                 alt="{{ cat_title | escape }}" loading="lazy" width="1200" height="750" />
          {%- elsif cat_image -%}
            <img class="cat-img" src="{{ cat_image | image_url: width: 900 }}"
                 srcset="{{ cat_image | image_url: width: 450 }} 450w,
                         {{ cat_image | image_url: width: 900 }} 900w,
                         {{ cat_image | image_url: width: 1200 }} 1200w"
                 sizes="{{ cat_sizes }}"
                 alt="{{ cat_title | escape }}" loading="lazy" width="900" height="563" />
          {%- endif -%}
          <span class="cat-arrow" aria-hidden="true"><span class="mi">arrow_forward</span></span>
          <div class="cat-ct">
            <h3>{{ cat_title }}</h3>
            {%- if block.settings.sub != blank -%}
              <span>{{ block.settings.sub }}</span>
            {%- elsif category.products_count > 0 -%}
              <span>{{ category.products_count }} fragrance{% if category.products_count != 1 %}s{% endif %}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- 7 · SHOP BY SCENT FAMILY -->
<section class="scent-section" id="scent-family">
  <div class="container">
    <div class="sec-head center fade-up">
      <span class="label">{{ section.settings.scent_eyebrow }}</span>
      <h2 class="sec-title">{{ section.settings.scent_heading }}</h2>
      {%- if section.settings.scent_sub != blank -%}<p class="sec-sub">{{ section.settings.scent_sub }}</p>{%- endif -%}
    </div>
    <div class="scent-grid">
      {%- for block in section.blocks -%}
        {%- if block.type != 'scent' -%}{%- continue -%}{%- endif -%}
        {%- assign scent = collections[block.settings.handle] -%}
        {%- if scent.handle == blank -%}{%- continue -%}{%- endif -%}
        {%- assign scent_asset = block.settings.image_asset -%}
        {%- assign scent_image = block.settings.image | default: scent.image -%}
        <a class="scent-card fade-up{% if scent_asset != blank or scent_image %} has-bg{% endif %}"
           href="{{ scent.url }}" {{ block.shopify_attributes }}>
          {%- if scent_asset != blank -%}
            <img class="scent-bg" src="{{ scent_asset | asset_url }}"
                 {%- if block.settings.image_asset_sm != blank %}
                 srcset="{{ block.settings.image_asset_sm | asset_url }} 350w, {{ scent_asset | asset_url }} 700w"
                 sizes="(max-width: 600px) 46vw, 18vw"
                 {%- endif %}
                 alt="" loading="lazy" width="700" height="700" />
          {%- elsif scent_image -%}
            <img class="scent-bg" src="{{ scent_image | image_url: width: 600 }}"
                 srcset="{{ scent_image | image_url: width: 300 }} 300w,
                         {{ scent_image | image_url: width: 600 }} 600w"
                 sizes="(max-width: 600px) 46vw, 18vw"
                 alt="" loading="lazy" width="600" height="600" />
          {%- endif -%}
          <span class="scent-ic"><span class="mi" aria-hidden="true">{{ block.settings.icon }}</span></span>
          <h3>{{ block.settings.title | default: scent.title }}</h3>
          <p>{{ block.settings.sub }}</p>
        </a>
      {%- endfor -%}
    </div>
    {%- if section.settings.scent_all_url != blank -%}
      <div class="scent-cta fade-up">
        <a class="see-all" href="{{ section.settings.scent_all_url }}">{{ section.settings.scent_all_label }}
          <span class="mi" aria-hidden="true">arrow_forward</span></a>
      </div>
    {%- endif -%}
  </div>
</section>

<!-- 8 · SHOP BY MOMENT -->
<section class="moment-section" id="moment">
  <div class="container">
    <div class="sec-head center fade-up">
      <span class="label">{{ section.settings.moment_eyebrow }}</span>
      <h2 class="sec-title" style="color:var(--white)">{{ section.settings.moment_heading }}</h2>
      {%- if section.settings.moment_sub != blank -%}<p class="sec-sub">{{ section.settings.moment_sub }}</p>{%- endif -%}
    </div>
    <div class="moment-wrap">
      {%- comment -%} Two columns: lifestyle and climate, six tiles each. {%- endcomment -%}
      {%- assign moment_cols = 'lifestyle,climate' | split: ',' -%}
      {%- for col in moment_cols -%}
        {%- if col == 'lifestyle' -%}
          {%- assign col_title = 'By Lifestyle' -%}
          {%- assign col_lead = 'Dress your scent for the occasion.' -%}
          {%- assign col_all_label = 'All lifestyles' -%}
          {%- assign col_all_url = '/pages/shop-by-lifestyle' -%}
        {%- else -%}
          {%- assign col_title = 'By Climate' -%}
          {%- assign col_lead = 'Built for UAE heat, and beyond.' -%}
          {%- assign col_all_label = 'All climates' -%}
          {%- assign col_all_url = '/pages/shop-by-climate' -%}
        {%- endif -%}
        <div class="moment-col">
          <h3 class="moment-title">{{ col_title }}</h3>
          <p class="moment-lead">{{ col_lead }}</p>
          <div class="moment-tiles">
            {%- for block in section.blocks -%}
              {%- if block.type != 'moment' or block.settings.column != col -%}{%- continue -%}{%- endif -%}
              {%- assign moment = collections[block.settings.handle] -%}
              {%- if moment.handle == blank -%}{%- continue -%}{%- endif -%}
              {%- assign moment_label = block.settings.title | default: moment.title | remove: ' Perfumes' -%}
              {%- assign moment_asset = block.settings.image_asset -%}
              {%- assign moment_image = block.settings.image | default: moment.image | default: moment.products.first.featured_image -%}
              <a class="moment-tile" href="{{ moment.url }}" {{ block.shopify_attributes }}>
                {%- if moment_asset != blank -%}
                  <img src="{{ moment_asset | asset_url }}"
                       {%- if block.settings.image_asset_sm != blank %}
                       srcset="{{ block.settings.image_asset_sm | asset_url }} 350w, {{ moment_asset | asset_url }} 700w"
                       sizes="(max-width: 600px) 92vw, (max-width: 900px) 30vw, 14vw"
                       {%- endif %}
                       alt="{{ moment_label | escape }}" loading="lazy" width="700" height="700">
                {%- elsif moment_image -%}
                  <img src="{{ moment_image | image_url: width: 700 }}"
                       srcset="{{ moment_image | image_url: width: 350 }} 350w,
                               {{ moment_image | image_url: width: 700 }} 700w"
                       sizes="(max-width: 600px) 92vw, (max-width: 900px) 30vw, 14vw"
                       alt="{{ moment_label | escape }}" loading="lazy">
                {%- endif -%}
                <span>{{ moment_label }}</span>
              </a>
            {%- endfor -%}
          </div>
          <a class="see-all moment-all" href="{{ col_all_url }}">{{ col_all_label }}
            <span class="mi" aria-hidden="true">arrow_forward</span></a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- 9 · INSTAGRAM -->
{%- comment -%}
  The feed itself comes from an Instagram app block, which holds and refreshes the
  Meta access token — a theme cannot do that safely, since anything it ships is
  readable in the browser and the token expires every 60 days.

  In the theme editor, add the app's block to this Home section and drag it here.
  The section renders only the heading until one is present, so the page never
  shows placeholder tiles pretending to be customer posts.
{%- endcomment -%}
{%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
{%- if app_blocks.size > 0 or request.design_mode -%}
  <section class="ugc">
    <div class="ugc-inner">
      <div class="ugc-head fade-up">
        <span class="label">{{ section.settings.ugc_eyebrow }}</span>
        <h2 class="sec-title">{{ section.settings.ugc_heading }}</h2>
        {%- if section.settings.ugc_sub != blank -%}
          <p class="sec-sub center" style="margin:8px auto 0">{{ section.settings.ugc_sub }}</p>
        {%- endif -%}
      </div>
      {%- for block in app_blocks -%}
        <div class="ugc-app" {{ block.shopify_attributes }}>{% render block %}</div>
      {%- endfor -%}
      {%- if app_blocks.size == 0 and request.design_mode -%}
        <p class="ugc-empty">No Instagram feed connected yet. Use <strong>Add block</strong> on this
          Home section and pick your Instagram app's block, then drag it here. This
          message is only visible in the theme editor.</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

<!-- 10 · FAQ -->
<section class="faq" id="faq">
  <div class="faq-inner">
    <div class="faq-head fade-up">
      <span class="label">Your Questions, Answered</span>
      <h2 class="sec-title">Frequently Asked <em>Questions</em></h2>
    </div>
    <div class="faq-list fade-up">
      {%- for block in section.blocks -%}
        {%- if block.type != 'faq' -%}{%- continue -%}{%- endif -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary class="faq-q">{{ block.settings.question }}<span class="mi" aria-hidden="true">add</span></summary>
          <div class="faq-a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- 11 · WHY CHOOSE THE FRAGRANCE SECRETS -->
<section class="section why-section">
  <div class="container">
    <div class="sec-head center fade-up">
      <span class="label">Why Shop With Us</span>
      <h2 class="sec-title">Why Choose <em>The Fragrance Secrets</em></h2>
      {%- if section.settings.why_sub != blank -%}
        <p class="sec-sub">{{ section.settings.why_sub }}</p>
      {%- endif -%}
    </div>
    {%- comment -%}
      Same treatment as the product page: six compact cards, icon and title only.
      The body copy stays on each block so it is not lost, simply unrendered.
    {%- endcomment -%}
    <div class="why-grid six">
      {%- for block in section.blocks -%}
        {%- if block.type != 'why' -%}{%- continue -%}{%- endif -%}
        <div class="why-card fade-up" {{ block.shopify_attributes }}>
          <span class="mi" aria-hidden="true">{{ block.settings.icon }}</span>
          <h3>{{ block.settings.title }}</h3>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%}
  Section 13 of the reference, the 10% welcome band, is rendered sitewide above
  the footer by sections/customer-login-cta.liquid, so it is not repeated here.
{%- endcomment -%}

