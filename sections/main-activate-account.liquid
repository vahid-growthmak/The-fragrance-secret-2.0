{%- comment -%}
  Activate account — reached from an invitation email. Same rebuild as login.
{%- endcomment -%}
<section class="page-hero tall"><div class="container">
  <div class="breadcrumb"><a href="{{ routes.root_url }}">Home</a><span class="mi" aria-hidden="true">chevron_right</span><span>Activate account</span></div>
  <span class="ph-eyebrow">Welcome</span>
  <h1 class="ph-title">Activate <em>Account</em></h1>
</div></section>

<section class="section"><div class="container">
  <div class="auth-wrap">
    <div class="auth-card">
      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="form-note form-note--err" role="alert">
            <span class="mi" aria-hidden="true">error</span>
            <ul>
              {%- for field in form.errors -%}
                <li>{% if field == 'form' %}{{ form.errors.messages[field] }}{% else %}{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}{% endif %}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <p class="auth-note">Set a password to finish activating your account.</p>
        <div class="field">
          <label for="ActivatePassword">Password</label>
          <input type="password" id="ActivatePassword" name="customer[password]" autocomplete="new-password" placeholder="At least 5 characters" required>
        </div>
        <div class="field">
          <label for="ActivatePasswordConfirm">Confirm password</label>
          <input type="password" id="ActivatePasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" placeholder="Repeat the password" required>
        </div>
        <button type="submit" class="btn-g auth-submit">Activate Account</button>
        <button type="submit" name="decline" class="auth-decline">Decline invitation</button>
      {%- endform -%}
    </div>
  </div>
</div></section>

{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
