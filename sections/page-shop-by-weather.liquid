{%- comment -%}
  Part B · schema. CollectionPage + ItemList + BreadcrumbList + FAQPage.
  Organization and WebSite are declared once on the home page, per the document.
{%- endcomment -%}
{%- assign page_url = canonical_url | default: request.origin | append: page.url -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Shop by Climate",
  "description": "Shop perfume by climate at The Fragrance Secrets. Find the right fragrance for hot, humid, desert, rainy and cooler days across 10 climate edits.",
  "url": {{ page_url | json }},
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ climate_tiles.size }},
    "itemListElement": [
      {%- for tile in climate_tiles -%}
        {%- assign parts = tile | split: '|' -%}
        {%- assign coll = collections[parts[0]] -%}
        {%- if coll.handle != blank -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "name": {{ parts[1] | json }},
          "url": {{ request.origin | append: coll.url | json }}
        }{% unless forloop.last %},{% endunless %}
        {%- endif -%}
      {%- endfor -%}
    ]
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | append: routes.root_url | json }} },
    { "@type": "ListItem", "position": 2, "name": "Shop by Climate", "item": {{ page_url | json }} }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How do I choose a perfume for the UAE climate?", "acceptedAnswer": { "@type": "Answer", "text": "Start with the temperature. For hot, humid days pick fresh and citrus scents in lighter concentrations, and save rich oud, amber and spice for cooler evenings. Our climate edits group them for you." } },
