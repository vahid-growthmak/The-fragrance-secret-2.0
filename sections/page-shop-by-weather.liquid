    { "@type": "Question", "name": "What perfume is best for hot, humid weather?", "acceptedAnswer": { "@type": "Answer", "text": "For hot, humid weather, choose fresh, citrus, aquatic and light floral scents in lighter concentrations. They stay crisp without turning heavy, so your fragrance feels clean and comfortable through a UAE summer day." } },
    { "@type": "Question", "name": "Should I change my perfume by season?", "acceptedAnswer": { "@type": "Answer", "text": "You do not have to, but many people do. Lighter, fresher scents suit summer heat, while warmer oud, amber and spice come alive in cooler months. A small seasonal rotation keeps you comfortable year round." } },
    { "@type": "Question", "name": "Why does my perfume smell different in summer?", "acceptedAnswer": { "@type": "Answer", "text": "Warmth and humidity change how a fragrance evaporates from your skin. In summer, top notes burn off faster and the scent can feel sharper or heavier than the same perfume does in cooler winter air." } },
    { "@type": "Question", "name": "Do you ship internationally?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. The Fragrance Secrets ships across the UAE and also delivers to customers in the United States and Canada. Shipping options and delivery estimates are available during checkout." } }
