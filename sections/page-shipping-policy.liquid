{%- comment -%}
  Shipping Policy page — the hero is the theme's, the policy text is the store's.

  This file used to hold a few thousand words of hand-written policy that
  nobody in the business had approved, sitting alongside a different version
  of the same document in Settings › Policies. shop.shipping_policy is what the merchant
  maintains and what Shopify publishes at /policies/…, so it is what renders
  here. The layout lives in snippets/policy-body.liquid, shared by all five
  legal pages.
{%- endcomment -%}

<!-- HERO -->
<section class="page-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="mi" aria-hidden="true">chevron_right</span>
      <span>Shipping Policy</span>
    </div>
    <span class="ph-eyebrow">Legal</span>
    <h1 class="ph-title">Shipping <em>Policy</em></h1>
    <p class="ph-sub">Everything you need to know about how, when and where we deliver your fragrances across the United Arab Emirates — including timelines, charges, tracking and our packaging standards.</p>
  </div>
</section>

{% render 'policy-body', policy_body: shop.shipping_policy.body, policy_url: shop.shipping_policy.url %}

{% schema %}
{ "name": "Shipping Policy page", "settings": [] }
{% endschema %}
