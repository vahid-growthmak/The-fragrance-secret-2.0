{%- comment -%}
  Hub hero — the top of a parent page (Shop by Category / Lifestyle / Scent
  Family / Brand): dark hero, intro block, and the grid of child collections.

  Blocks:
    link — one child collection tile
{%- endcomment -%}

{%- assign child_blocks = section.blocks | where: 'type', 'link' -%}

{%- comment -%}
  Optional full-bleed banner, the same asset-plus-phone-variant arrangement the
  collection hero uses. Without one the hero keeps its plain dark treatment.
{%- endcomment -%}
<section class="page-hero tall{% if section.settings.hero_bg_image != blank %} has-bg{% endif %}">
  {%- if section.settings.hero_bg_image != blank -%}
    <div class="ph-bg" aria-hidden="true">
      <img src="{{ section.settings.hero_bg_image | asset_url }}"
           {%- if section.settings.hero_bg_image_sm != blank %}
           srcset="{{ section.settings.hero_bg_image_sm | asset_url }} 1200w,
                   {{ section.settings.hero_bg_image | asset_url }} 2880w"
           sizes="100vw"
           {%- endif %}
           alt="" width="2880" height="1000" loading="eager" fetchpriority="high" decoding="async">
    </div>
  {%- endif -%}
  <div class="container">
    <div class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="mi" aria-hidden="true">chevron_right</span>
      <a href="/collections/all">Perfumes</a>
      <span class="mi" aria-hidden="true">chevron_right</span>
      <span>{{ section.settings.hero_heading | strip_html }}</span>
    </div>
    {%- if section.settings.hero_eyebrow != blank -%}<span class="ph-eyebrow">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
    <h1 class="ph-title">{{ section.settings.hero_heading }}</h1>
    <div class="ph-meta">
      <span><span class="mi" aria-hidden="true">verified_user</span>100% Authentic</span>
      <span><span class="mi" aria-hidden="true">local_shipping</span>Fast Shipping</span>
      <span><span class="mi" aria-hidden="true">lock</span>Secure Checkout</span>
    </div>
  </div>
</section>

{%- if section.settings.intro_heading != blank or section.settings.intro_text != blank -%}
  <section class="section-sm coll-intro"><div class="container coll-intro-grid">
    <div class="coll-intro-copy">
      {%- if section.settings.intro_eyebrow != blank -%}<span class="label">{{ section.settings.intro_eyebrow }}</span>{%- endif -%}
      {%- if section.settings.intro_heading != blank -%}<h2 class="sec-title">{{ section.settings.intro_heading }}</h2>{%- endif -%}
      {%- if section.settings.intro_text != blank -%}<div class="sec-sub coll-intro-body">{{ section.settings.intro_text }}</div>{%- endif -%}
    </div>
    {% render 'why-choose-rotator', uid: section.id %}
  </div></section>
{%- endif -%}

{%- if child_blocks.size > 0 -%}
  <section class="section"><div class="container">
    <div class="sec-head center">
      {%- if section.settings.children_eyebrow != blank -%}<span class="label">{{ section.settings.children_eyebrow }}</span>{%- endif -%}
      {%- if section.settings.children_heading != blank -%}<h2 class="sec-title">{{ section.settings.children_heading }}</h2>{%- endif -%}
      {%- if section.settings.children_sub != blank -%}<p class="sec-sub">{{ section.settings.children_sub }}</p>{%- endif -%}
    </div>
    {%- comment -%}
      Image tiles rather than text links, reusing .moment-tile from the home
      page's Lifestyle/Climate grid so the hubs and the home page present their
      child collections identically.

      Image priority: the block's own asset, then the collection's image, then
      its first product photo. A child that resolves to none of those keeps
      .moment-tile's gradient, which is the same fallback the home page relies
      on — the tile still reads as deliberate rather than broken.
    {%- endcomment -%}
    <div class="hub-children fade-up">
      {%- for block in child_blocks -%}
        {%- liquid
          assign child_coll = nil
          if block.settings.url contains '/collections/'
            assign child_handle = block.settings.url | split: '/collections/' | last | split: '?' | first
            assign child_coll = collections[child_handle]
          endif
          assign child_img = child_coll.image | default: child_coll.products.first.featured_image
        -%}
        <a class="moment-tile" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image_asset != blank -%}
            <img src="{{ block.settings.image_asset | asset_url }}"
                 {%- if block.settings.image_asset_sm != blank %}
                 srcset="{{ block.settings.image_asset_sm | asset_url }} 400w, {{ block.settings.image_asset | asset_url }} 800w"
                 sizes="(max-width: 600px) 46vw, (max-width: 1200px) 30vw, 18vw"
                 {%- endif %}
                 alt="{{ block.settings.label | escape }}" loading="lazy" width="800" height="800">
          {%- elsif child_img -%}
            <img src="{{ child_img | image_url: width: 800 }}"
                 srcset="{{ child_img | image_url: width: 400 }} 400w, {{ child_img | image_url: width: 800 }} 800w"
                 sizes="(max-width: 600px) 46vw, (max-width: 1200px) 30vw, 18vw"
                 alt="{{ block.settings.label | escape }}" loading="lazy">
          {%- endif -%}
          <span>{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div></section>
{%- endif -%}

{% schema %}
{
  "name": "Hub hero",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_bg_image", "label": "Hero background image (theme asset filename)", "info": "e.g. brands-hub-hero.webp — the file must live in assets/. Best at 2880 × 1000 with the left side dark." },
    { "type": "text", "id": "hero_bg_image_sm", "label": "Hero background image, small (theme asset filename)", "info": "Optional 1200 × 417 variant served to phones." },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "hero_heading", "label": "Heading (H1)", "info": "Wrap words in <em></em> for the gold italic accent." },
    { "type": "header", "content": "Introduction" },
    { "type": "text", "id": "intro_eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "intro_heading", "label": "Heading (H2)", "info": "Carries the page's primary keyword." },
    { "type": "richtext", "id": "intro_text", "label": "Intro copy" },
    { "type": "header", "content": "Child collections" },
    { "type": "text", "id": "children_eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "children_heading", "label": "Heading (H2)" },
    { "type": "textarea", "id": "children_sub", "label": "Intro paragraph" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Child collection",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "text", "id": "image_asset", "label": "Tile image (theme asset filename)", "info": "e.g. desert-climate-tile.webp — the file must live in assets/. Leave blank to fall back to the collection's own image, then its first product photo." },
        { "type": "text", "id": "image_asset_sm", "label": "Tile image, small (theme asset filename)", "info": "Optional smaller variant served to phones." }
      ]
    }
  ],
  "presets": [ { "name": "Hub hero" } ]
}
{% endschema %}
