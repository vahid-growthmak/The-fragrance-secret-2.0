{%- comment -%}
  Return policy page — the hero is the theme's, the policy text is the store's.

  This file used to hold a few thousand words of hand-written policy that
  nobody in the business had approved, sitting alongside a different version
  of the same document in Settings › Policies. shop.refund_policy is what the merchant
  maintains and what Shopify publishes at /policies/…, so it is what renders
  here. The layout lives in snippets/policy-body.liquid, shared by all five
  legal pages.
{%- endcomment -%}

<!-- HERO -->
<section class="page-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="mi" aria-hidden="true">chevron_right</span>
      <span>Return &amp; Refund Policy</span>
    </div>
    <span class="ph-eyebrow">Legal</span>
    <h1 class="ph-title">Return &amp; Refund <em>Policy</em></h1>
    <p class="ph-sub">Your satisfaction matters to us. Here is exactly how returns, exchanges and refunds work at The Fragrance Secrets — including the {{ settings.returns_window_days | default: '2' }}-day window for faulty, wrong or incomplete orders and how to start one.</p>
  </div>
</section>

{% render 'policy-body', policy_body: shop.refund_policy.body, policy_url: shop.refund_policy.url %}

{% schema %}
{ "name": "Return policy page", "settings": [] }
{% endschema %}
