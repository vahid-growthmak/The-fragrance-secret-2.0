{%- comment -%} ── Structured data: BreadcrumbList + CollectionPage/ItemList + FAQPage ── {%- endcomment -%}
{%- assign coll_url = shop.url | append: collection.url -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": {{ coll_url | append: '#breadcrumb' | json }},
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} },
    { "@type": "ListItem", "position": 2, "name": "Perfumes", "item": {{ shop.url | append: '/collections/all' | json }} },
    { "@type": "ListItem", "position": 3, "name": "Men's Perfumes", "item": {{ coll_url | json }} }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": {{ coll_url | append: '#collectionpage' | json }},
  "url": {{ coll_url | json }},
  "name": "Men's Perfumes UAE",
  "description": "Authentic designer and Arabian men's perfumes at The Fragrance Secrets, from fresh citrus office scents to rich oud, chosen to perform in the UAE climate.",
  "isPartOf": { "@id": {{ shop.url | append: '/#website' | json }} },
  "breadcrumb": { "@id": {{ coll_url | append: '#breadcrumb' | json }} },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {%- for product in collection.products -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": {{ shop.url | append: product.url | json }},
        "name": {{ product.title | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
</script>

