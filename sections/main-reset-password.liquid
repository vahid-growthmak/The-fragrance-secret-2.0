{%- comment -%}
  Reset password — reached from the emailed link. Same rebuild as login.
{%- endcomment -%}
<section class="page-hero tall"><div class="container">
  <div class="breadcrumb"><a href="{{ routes.root_url }}">Home</a><span class="mi" aria-hidden="true">chevron_right</span><span>Reset password</span></div>
  <span class="ph-eyebrow">Account</span>
  <h1 class="ph-title">Reset <em>Password</em></h1>
</div></section>

<section class="section"><div class="container">
  <div class="auth-wrap">
    <div class="auth-card">
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <div class="form-note form-note--err" role="alert">
            <span class="mi" aria-hidden="true">error</span>
            <ul>
              {%- for field in form.errors -%}
                <li>{% if field == 'form' %}{{ form.errors.messages[field] }}{% else %}{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}{% endif %}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <p class="auth-note">Choose a new password for your account.</p>
        <div class="field">
          <label for="ResetPassword">New password</label>
          <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" placeholder="At least 5 characters" required>
        </div>
        <div class="field">
          <label for="ResetPasswordConfirm">Confirm password</label>
          <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" placeholder="Repeat the password" required>
        </div>
        <button type="submit" class="btn-g auth-submit">Reset Password</button>
      {%- endform -%}
    </div>
  </div>
</div></section>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
