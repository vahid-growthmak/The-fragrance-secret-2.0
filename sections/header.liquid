{%- comment -%}
  Site header + Shop mega-menu — ported from app.js headerHTML()/navItemHTML().
  Internal links now point at native Shopify routes (/collections, /pages, /blogs).
  All interactivity (mobile drawer, scroll state) is handled by app.js.
{%- endcomment -%}

{%- liquid
  assign header_theme = section.settings.theme | default: 'dark'
  assign cart_count = cart.item_count | default: 0

  # Which top-level nav item the current page belongs to. The .nav-active
  # underline has always existed in the stylesheet, but the only thing that
  # ever set it was navItemHTML() in app.js — the demo renderer this section
  # replaced — so on the live site nothing was ever marked current.
  #
  # Brand and category pages are collections, so they light up Shop. The Brands
  # hub itself is a page and is matched by handle below.
  assign nav_active = ''
  case request.page_type
    when 'collection'
      assign nav_active = 'shop'
    when 'product'
      assign nav_active = 'shop'
    when 'list-collections'
      assign nav_active = 'shop'
    when 'blog'
      assign nav_active = 'guides'
    when 'article'
      assign nav_active = 'guides'
  endcase

  if request.page_type == 'page'
    assign shop_hub_pages = 'shop-by-lifestyle,shop-by-weather,shop-by-scent-family,crazy-deals,luxury-recommendations,category-collection' | split: ','
    assign guide_pages = 'buying-guides,guide-article,journal,scent-education,care-storage,seasonal-trends' | split: ','
    if page.handle == 'brands'
      assign nav_active = 'brands'
    elsif page.handle == 'about'
      assign nav_active = 'about'
    elsif shop_hub_pages contains page.handle
      assign nav_active = 'shop'
    elsif guide_pages contains page.handle
      assign nav_active = 'guides'
    endif
  endif
-%}

<header id="hdr" class="{{ header_theme }}">
  <div class="nav-wrap">
    <a href="{{ routes.root_url }}" class="nav-logo" aria-label="{{ shop.name }} — Home">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="160">
      {%- else -%}
        <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}">
      {%- endif -%}
    </a>

    <button class="nav-burger" aria-label="Menu" onclick="toggleMobileNav()"><span class="mi" aria-hidden="true">menu</span></button>

    <nav class="nav-links" id="navLinks">
      {%- comment -%} Shop — with mega-menu {%- endcomment -%}
      <div class="nav-item has-mega">
        <a href="/collections/all" class="nav-toplink{% if nav_active == 'shop' %} nav-active{% endif %}"{% if nav_active == 'shop' %} aria-current="page"{% endif %}>Shop<span class="mi nav-caret" aria-hidden="true">expand_more</span></a>
        <div class="nav-mega"><div class="nav-mega-inner container">
          <div class="nm-col"><h5>Shop</h5>
            <a href="/collections/all">All Products</a>
            <a href="/collections/best-sellers">Best Sellers</a>
            <a href="/collections/new-arrivals">New Arrivals</a>
            <a href="/collections/crazy-deals">Crazy Deals</a>
          </div>
          <div class="nm-col"><h5>Shop by Category</h5>
            <a href="/collections/mens">Men's Perfumes</a>
            <a href="/collections/womens">Women's Perfumes</a>
            <a href="/collections/kids">Kids Perfumes</a>
            <a href="/collections/unisex">Unisex Perfumes</a>
            <a href="/collections/luxury">Luxury Perfumes</a>
            <a href="/collections/miracle-plant">Miracle Plant</a>
            <a href="/collections/perfume-oil">Perfume Oil</a>
            <a href="/collections/attar">Attar</a>
            <a href="/collections/arabic">Arabic Perfumes</a>
            <a href="/collections/inspired">Inspired Perfumes</a>
          </div>
          <div class="nm-col"><h5>Shop by Lifestyle</h5>
            <a href="/collections/everyday-signature">Everyday Perfumes</a>
            <a href="/collections/office-wear">Office Wear Perfumes</a>
            <a href="/collections/date-night">Date Night Perfumes</a>
            <a href="/collections/party-clubbing">Party Wear Perfumes</a>
            <a href="/collections/wedding">Wedding Perfumes</a>
            <a href="/collections/wedding-formal">Formal Event Perfumes</a>
            <a href="/collections/gym">Gym Perfumes</a>
            <a href="/collections/travel-friendly">Travel Perfumes</a>
            <a href="/collections/beach-vacation">Beach Perfumes</a>
            <a href="/collections/vacation-beach">Vacation Perfumes</a>
            <a href="/collections/dinner-evening">Evening Wear Perfumes</a>
          </div>
          <div class="nm-col"><h5>Shop by Climate</h5>
            <a href="/collections/summer-wear">Summer Wear Perfumes</a>
            <a href="/collections/winter-holiday">Winter Wear Perfumes</a>
            <a href="/collections/spring-bloom">Spring Wear Perfumes</a>
            <a href="/collections/rainy-day">Rainy Day Perfumes</a>
            <a href="/collections/humid-weather">Humid Weather Perfumes</a>
            <a href="/collections/tropical-climate">Tropical Climate Perfumes</a>
            <a href="/collections/desert-climate">Desert Climate Perfumes</a>
            <a href="/collections/hot-weather">Hot Weather Perfumes</a>
            <a href="/collections/cold-weather">Cold Weather Perfumes</a>
            <a href="/collections/dry-weather">Dry Weather Perfumes</a>
          </div>
          <div class="nm-col"><h5>By Scent Family</h5>
            <a href="/collections/oud-woody">Oud &amp; Woody</a>
            <a href="/collections/fresh-citrus">Fresh &amp; Citrus</a>
            <a href="/collections/floral-rose">Floral &amp; Rose</a>
            <a href="/collections/sweet-gourmand">Sweet &amp; Gourmand</a>
            <a href="/collections/spicy-oriental">Spicy &amp; Oriental</a>
          </div>
        </div></div>
      </div>

      <a href="/pages/brands" class="nav-toplink{% if nav_active == 'brands' %} nav-active{% endif %}"{% if nav_active == 'brands' %} aria-current="page"{% endif %}>Brands</a>
      <a href="/blogs/journal" class="nav-toplink{% if nav_active == 'guides' %} nav-active{% endif %}"{% if nav_active == 'guides' %} aria-current="page"{% endif %}>Guides</a>
      <a href="/pages/about" class="nav-toplink{% if nav_active == 'about' %} nav-active{% endif %}"{% if nav_active == 'about' %} aria-current="page"{% endif %}>About Us</a>

      <a href="#" class="nav-toplink nav-quiz" onclick="openAI();closeMobileNav();return false"><span class="mi" aria-hidden="true">auto_awesome</span>Find My Scent</a>
      <a href="{{ routes.search_url }}" class="nav-toplink nav-drawer-extra"><span class="mi" aria-hidden="true">search</span>Search</a>
      <a href="{{ routes.account_url }}" class="nav-toplink nav-drawer-extra"><span class="mi" aria-hidden="true">person</span>Account</a>
      <a href="/pages/wishlist" class="nav-toplink nav-drawer-extra"><span class="mi" aria-hidden="true">favorite</span>Wishlist</a>
    </nav>

    <div class="nav-actions">
      <a class="ni" href="{{ routes.search_url }}" title="Search"><span class="mi" aria-hidden="true">search</span></a>
      <a class="ni" href="{{ routes.account_url }}" title="Account"><span class="mi" aria-hidden="true">person</span></a>
      {%- comment -%}
        The wishlist count lives in localStorage, so it cannot be rendered
        server-side. The badge starts hidden and wishlist.js fills it in —
        better than painting a "0" that flickers to a real number on load.
      {%- endcomment -%}
      <a class="ni" href="/pages/wishlist" title="Wishlist">
        <span class="mi" aria-hidden="true">favorite</span>
        <span class="wbadge" hidden>0</span>
      </a>
      <a class="ni" href="{{ routes.cart_url }}" title="Cart">
        <span class="mi" aria-hidden="true">shopping_bag</span>
        <span class="cbadge">{{ cart_count }}</span>
      </a>
    </div>
  </div>
</header>
<div class="nav-overlay" id="navOverlay" onclick="toggleMobileNav()" aria-hidden="true"></div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "select", "id": "theme", "label": "Header theme", "options": [
      { "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" }
    ], "default": "dark" }
  ]
}
{% endschema %}
