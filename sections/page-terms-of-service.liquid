{%- comment -%}
  Terms & Conditions page — the hero is the theme's, the policy text is the store's.

  This file used to hold a few thousand words of hand-written policy that
  nobody in the business had approved, sitting alongside a different version
  of the same document in Settings › Policies. shop.terms_of_service is what the merchant
  maintains and what Shopify publishes at /policies/…, so it is what renders
  here. The layout lives in snippets/policy-body.liquid, shared by all five
  legal pages.
{%- endcomment -%}

<!-- HERO -->
<section class="page-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="mi" aria-hidden="true">chevron_right</span>
      <span>Terms &amp; Conditions</span>
    </div>
    <span class="ph-eyebrow">Legal</span>
    <h1 class="ph-title">Terms &amp; <em>Conditions</em></h1>
    <p class="ph-sub">The terms that govern your use of thefragrancesecrets.com and any purchase you make with us. Please read them carefully before shopping.</p>
  </div>
</section>

{% render 'policy-body', policy_body: shop.terms_of_service.body, policy_url: shop.terms_of_service.url %}

{% schema %}
{ "name": "Terms & Conditions page", "settings": [] }
{% endschema %}
