{%- comment -%}
  Payment Policy page — the hero is the theme's, the text is the store's.

  Shopify has no payment policy of its own, so unlike its four siblings this
  one is not in Settings › Policies: the real document is the admin page's own
  content, which is what page.content renders. Same shared layout as the
  policies, same reason — the copy belongs to the business, not the build.
{%- endcomment -%}

<!-- HERO -->
<section class="page-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="mi" aria-hidden="true">chevron_right</span>
      <span>Payment Policy</span>
    </div>
    <span class="ph-eyebrow">Legal</span>
    <h1 class="ph-title">Payment <em>Policy</em></h1>
    <p class="ph-sub">Every way you can pay at The Fragrance Secrets — from Cash on Delivery across all seven Emirates to interest-free instalments with Tabby and Tamara — plus how we keep your card and wallet details secure at checkout.</p>
  </div>
</section>

{% render 'policy-body', policy_body: page.content %}

{% schema %}
{ "name": "Payment Policy page", "settings": [] }
{% endschema %}
