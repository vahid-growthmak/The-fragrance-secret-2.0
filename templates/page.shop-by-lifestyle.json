        "faq3": {
          "type": "faq",
          "settings": {
            "question": "Which fragrance suits a night out?",
            "answer": "For a night out, richer, longer-lasting scents work best: warm oud, sweet gourmand or bold oriental fragrances that project and last. Explore our Date Night and Party Wear edits."
          }
        },
        "faq4": {
          "type": "faq",
          "settings": {
            "question": "How many perfumes should I own for different occasions?",
            "answer": "There is no fixed number, but many people keep three to five: a versatile daily, a fresh active scent, and one or two richer options for evenings and events."
          }
        },
