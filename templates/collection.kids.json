        },
        "faq4": {
          "type": "faq",
          "settings": {
            "question": "Why choose alcohol-free perfume for kids?",
            "answer": "Alcohol is what makes many sprays feel harsh and drying. Removing it gives a milder product that is far gentler on young, sensitive skin, which is why alcohol-free mists are the recommended starting point for children."
          }
        },
        "faq5": {
          "type": "faq",
          "settings": {
            "question": "How should my child apply their fragrance?",
            "answer": "Keep it simple and light. Spray once onto clothing rather than directly onto the skin, and avoid the face and eyes. Applying to fabric lets your child enjoy the scent while reducing any chance of a skin reaction."
          }
        },
        "faq6": {
          "type": "faq",
          "settings": {
            "question": "What should I do if my child has sensitive skin or allergies?",
            "answer": "Patch test first: apply a small amount to the inner arm and wait to check for any reaction before wider use. If your child has known allergies, eczema or very sensitive skin, speak to your paediatrician before introducing any new fragrance."
          }
